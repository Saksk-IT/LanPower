<Window x:Class="LanPower.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanPower · 电脑电源管理" Width="1140" Height="800" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="Assets/LanPower.ico"
        Background="{StaticResource Surface}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Foreground="{StaticResource Ink}" UseLayoutRounding="True" Loaded="OnLoaded">
  <Grid Background="{StaticResource Surface}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#153441">
      <Grid Margin="18,28,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="8,0,0,8">
            <Image Source="Assets/LanPower.png" Width="40" Height="40" Margin="0,0,11,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="LanPower" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
              <TextBlock Text="让连接与控制更简单" Foreground="#9DB9C2" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="工作空间" Foreground="#789DA9" FontSize="11" Margin="16,32,0,14"/>
          <RadioButton x:Name="OverviewNav" GroupName="Navigation" Tag="overview" Style="{StaticResource NavigationButton}" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" Margin="0,0,13,0"/><TextBlock Text="设备总览"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="PairingNav" GroupName="Navigation" Tag="pairing" Style="{StaticResource NavigationButton}" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xED14;" FontFamily="Segoe Fluent Icons" Margin="0,0,13,0"/><TextBlock Text="手机配对"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="CloudNav" GroupName="Navigation" Tag="cloud" Style="{StaticResource NavigationButton}" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons" Margin="0,0,13,0"/><TextBlock Text="远程连接"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NetworkNav" GroupName="Navigation" Tag="network" Style="{StaticResource NavigationButton}" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons" Margin="0,0,13,0"/><TextBlock Text="网络设置"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="LogsNav" GroupName="Navigation" Tag="logs" Style="{StaticResource NavigationButton}" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Margin="0,0,13,0"/><TextBlock Text="日志诊断"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="SettingsNav" GroupName="Navigation" Tag="settings" Style="{StaticResource NavigationButton}" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,13,0"/><TextBlock Text="应用设置"/></StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Border Background="#1F424F" CornerRadius="8" Padding="14">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="SidebarDot" Width="7" Height="7" Fill="#90A7AF" Margin="0,0,8,0"/>
                <TextBlock x:Name="SidebarState" Text="正在连接服务" Foreground="#D8E7EB" FontSize="12"/>
              </StackPanel>
              <TextBlock Text="后台服务持续守护连接" Foreground="#97B3BE" FontSize="11" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="SidebarVersion" Text="Windows 1.6.1" Foreground="#86A8B5" FontSize="11" Margin="14,16,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="32,26,32,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="设备总览" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageHint" Text="这台电脑的连接状态，一目了然。" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
        </StackPanel>
        <Button x:Name="RefreshStatusButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="RefreshStatus" VerticalAlignment="Center" ToolTip="重新读取后台服务状态">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/><TextBlock Text="刷新状态"/></StackPanel>
        </Button>
      </Grid>

      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,24">
        <Grid>
          <StackPanel x:Name="OverviewView">
            <Border x:Name="FirstRunPanel" Background="#E5F4ED" CornerRadius="8" Padding="18" Margin="0,0,0,18" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="欢迎使用 LanPower" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="先用手机配对，即可在家控制电脑。云端连接可随时配置。" Style="{StaticResource Caption}" Margin="0,6,12,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="开始使用" Click="FinishWelcome" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <Border CornerRadius="8" Padding="26" Margin="0,0,0,20">
              <Border.Background><SolidColorBrush Color="#E8F3EF"/></Border.Background>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="当前设备" Foreground="#50776C" FontSize="12" Margin="0,0,12,0"/>
                    <Border x:Name="DeviceBadge" Background="#D4E8DF" CornerRadius="8" Padding="10,4">
                      <StackPanel Orientation="Horizontal"><Ellipse x:Name="DeviceDot" Width="6" Height="6" Fill="#879E9D" Margin="0,0,6,0"/><TextBlock x:Name="DeviceState" Text="正在连接服务…" FontSize="11"/></StackPanel>
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="DeviceName" Text="我的电脑" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="DeviceSummary" Text="正在读取连接状态，请稍候。" Foreground="#52746B" TextWrapping="Wrap" Margin="0,9,12,18"/>
                  <WrapPanel>
                    <Button Content="连接我的手机" Tag="pairing" Click="NavigateFromButton" Margin="0,0,10,0"/>
                    <Button Content="配置远程连接" Tag="cloud" Click="NavigateFromButton" Style="{StaticResource SecondaryButton}"/>
                  </WrapPanel>
                </StackPanel>
                <Viewbox Grid.Column="1" Width="140" Height="135" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False">
                  <Canvas Width="160" Height="150">
                    <Ellipse Width="138" Height="138" Fill="#D7EDE4" Canvas.Left="11" Canvas.Top="6"/>
                    <Rectangle Width="124" Height="82" RadiusX="10" RadiusY="10" Fill="#244D57" Canvas.Left="18" Canvas.Top="24"/>
                    <Rectangle Width="108" Height="66" RadiusX="5" RadiusY="5" Fill="#F1FCF6" Canvas.Left="26" Canvas.Top="32"/>
                    <Path Stroke="#238F75" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M80,45 L80,62 M67,51 A19,19 0 1 0 93,51"/>
                    <Rectangle Width="14" Height="15" Fill="#244D57" Canvas.Left="73" Canvas.Top="106"/>
                    <Rectangle Width="52" Height="6" RadiusX="3" RadiusY="3" Fill="#244D57" Canvas.Left="54" Canvas.Top="121"/>
                    <Ellipse Width="24" Height="24" Fill="#147D6A" Canvas.Left="126" Canvas.Top="90"/>
                    <Path Data="M132,102 L137,107 L144,98" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Canvas>
                </Viewbox>
              </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,20">
              <Border Style="{StaticResource StatusCard}" Margin="0,0,10,0">
                <StackPanel>
                  <DockPanel Margin="0,0,0,14"><TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{StaticResource Accent}"/><Ellipse x:Name="LanDot" Width="8" Height="8" Fill="#90A7AF" HorizontalAlignment="Right"/></DockPanel>
                  <TextBlock Text="局域网连接" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock x:Name="LanState" Text="检测中" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,8" TextWrapping="Wrap"/>
                  <TextBlock Text="在同一网络，用手机控制电脑" Style="{StaticResource Caption}"/>
                  <Button Content="手机配对  →" Tag="pairing" Click="NavigateFromButton" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatusCard}" Margin="0,0,10,0">
                <StackPanel>
                  <DockPanel Margin="0,0,0,14"><TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{StaticResource Accent}"/><Ellipse x:Name="CloudDot" Width="8" Height="8" Fill="#90A7AF" HorizontalAlignment="Right"/></DockPanel>
                  <TextBlock Text="云端连接" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock x:Name="CloudState" Text="检测中" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,8" TextWrapping="Wrap"/>
                  <TextBlock Text="在外也能控制在线的电脑" Style="{StaticResource Caption}"/>
                  <Button Content="远程连接  →" Tag="cloud" Click="NavigateFromButton" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatusCard}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,14"><TextBlock Text="&#xE839;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{StaticResource Accent}"/><Ellipse x:Name="GatewayDot" Width="8" Height="8" Fill="#90A7AF" HorizontalAlignment="Right"/></DockPanel>
                  <TextBlock Text="唤醒网关" FontWeight="SemiBold" FontSize="14"/>
                  <TextBlock x:Name="GatewayState" Text="检测中" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,8" TextWrapping="Wrap"/>
                  <TextBlock Text="通过家中网关，远程唤醒电脑" Style="{StaticResource Caption}"/>
                  <Button x:Name="GatewaySetupLink" Content="配置远程唤醒  →" Click="OpenGatewaySetup" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border Style="{StaticResource Section}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="控制路径" Style="{StaticResource SectionTitle}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                  <TextBlock Text="在家控制" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="手机  ───  局域网  ───  这台电脑" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LanRoute" Grid.Column="2" Text="检测中" HorizontalAlignment="Right" FontSize="12"/>
                  <TextBlock Grid.Row="1" Text="在外控制" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Grid.Column="1" Text="浏览器 / 手机  ───  Cloud  ───  在线电脑" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CloudRoute" Grid.Row="1" Grid.Column="2" Text="检测中" HorizontalAlignment="Right" FontSize="12"/>
                  <TextBlock Grid.Row="2" Text="远程唤醒" FontWeight="SemiBold"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Cloud  ───  家中唤醒网关  ───  离线电脑" Foreground="{StaticResource Muted}"/><TextBlock x:Name="WakeRoute" Grid.Row="2" Grid.Column="2" Text="检测中" HorizontalAlignment="Right" FontSize="12"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
              <StackPanel>
                <Grid Margin="0,0,0,14">
                  <TextBlock Text="网络与唤醒" FontSize="16" FontWeight="SemiBold"/>
                  <Button Content="复制网络信息" Click="CopyNetworkInfo" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="0"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="局域网 IP" Style="{StaticResource Caption}" Margin="0,0,0,5"/><TextBox x:Name="LanIp" Text="—" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="局域网 IP"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="网卡 MAC" Style="{StaticResource Caption}" Margin="0,0,0,5"/><TextBox x:Name="Mac" Text="—" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="网卡 MAC"/></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBlock Text="Wake-on-LAN" Foreground="{StaticResource Muted}" Margin="0,0,16,0"/><TextBlock x:Name="WolState" Text="检测中" FontWeight="SemiBold"/></StackPanel>
                <TextBlock Text="系统允许网卡唤醒后，仍需实测睡眠、休眠与关机唤醒。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PairingView" Visibility="Collapsed">
            <Border Style="{StaticResource Section}" Margin="0,0,0,20">
              <UniformGrid Columns="3">
                <StackPanel><TextBlock Text="01  连接同一网络" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="手机与电脑接入家中局域网" Style="{StaticResource Caption}" Margin="0,8,14,0"/></StackPanel>
                <StackPanel><TextBlock Text="02  显示配对二维码" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="点击下方按钮，在本机显示" Style="{StaticResource Caption}" Margin="0,8,14,0"/></StackPanel>
                <StackPanel><TextBlock Text="03  用小程序扫码" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="在 LanPower 小程序中完成配对" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
              </UniformGrid>
            </Border>
            <Border Style="{StaticResource Section}" Padding="28">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FBFCFD" CornerRadius="8" Width="240" Height="240">
                    <Grid Margin="10">
                      <Image x:Name="PairingQr" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="手机配对二维码"/>
                      <StackPanel x:Name="PairingPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xED14;" FontFamily="Segoe Fluent Icons" FontSize="54" Foreground="#9FB6BD" HorizontalAlignment="Center"/>
                        <TextBlock Text="点击按钮显示二维码" Foreground="{StaticResource Muted}" Margin="0,20,0,0" FontSize="12"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <TextBlock x:Name="QrExpiry" Text="仅在本机显示，不保存到文件" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="28,12,0,0">
                  <TextBlock Text="连接你的手机" FontSize="22" FontWeight="SemiBold"/>
                  <TextBlock Text="配对后，在家可查看电脑状态并进行电源操作。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,18"/>
                  <Button x:Name="ShowQrButton" Content="显示配对二维码" Click="ShowPairingQr" HorizontalAlignment="Left"/>
                  <Button x:Name="HideQrButton" Content="收起二维码" Click="HidePairingQr" Style="{StaticResource QuietButton}" Visibility="Collapsed" Margin="0,8,0,0"/>
                  <TextBlock x:Name="PairingNotice" Text="二维码包含控制凭据，请只让自己的手机扫码。" Style="{StaticResource Caption}" Margin="0,18,0,14"/>
                  <Button Content="打开浏览器配对页" Click="OpenPairing" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Background="#EAF0F4" CornerRadius="8" Padding="20" Margin="0,20,0,0">
              <StackPanel>
                <TextBlock Text="配对遇到问题？" FontWeight="SemiBold"/>
                <TextBlock Text="确认手机连接主 Wi-Fi，避免访客网络。电脑地址或网卡变化后，需要重新扫码确认连接地址。" Style="{StaticResource Caption}" Margin="0,8,0,10"/>
                <Button Content="检查网络设置  →" Tag="network" Click="NavigateFromButton" Style="{StaticResource QuietButton}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="CloudView" Visibility="Collapsed">
            <Border Style="{StaticResource Section}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="在外也能连接这台电脑" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="连接自己的 Cloud 后，可通过浏览器或已授权的小程序控制在线电脑。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,20"/>
                <TextBlock Text="Cloud 地址" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="CloudUrlBox" Text="https://" AutomationProperties.Name="Cloud 地址"/>
                <TextBlock Text="输入你部署的 HTTPS 地址，在网页核对设备名称与配对码后批准。" Style="{StaticResource Caption}" Margin="0,8,0,16"/>
                <WrapPanel>
                  <Button x:Name="CloudConnectButton" Content="连接 Cloud" Click="ConnectCloud" Margin="0,0,10,8"/>
                  <Button Content="打开 Cloud 网页" Click="OpenCloud" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"/>
                  <Button x:Name="CloudDisconnectButton" Content="断开连接" Click="DisconnectCloud" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,0,8"/>
                </WrapPanel>
                <TextBlock x:Name="CloudNotice" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Accent}"/>
                <Border x:Name="CloudPairingPanel" Background="#EAF5EF" CornerRadius="8" Padding="20" Margin="0,18,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock Text="在网页输入设备配对码" FontWeight="SemiBold"/>
                    <TextBox x:Name="CloudUserCode" IsReadOnly="True" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,10" AutomationProperties.Name="Cloud 设备配对码"/>
                    <ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource Accent}" BorderThickness="0" Margin="0,0,0,12"/>
                    <TextBlock Text="配对码 10 分钟内有效。核对设备名称一致后，点击允许连接。" Style="{StaticResource Caption}"/>
                    <Button Content="停止等待" Click="CancelCloudWait" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
                <Expander Header="连接旧版 Cloud" Margin="0,20,0,0">
                  <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="旧版 Cloud 使用网页生成的一次性长配对码。" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="CloudCodeBox" AutomationProperties.Name="旧版 Cloud 配对码"/>
                    <Button x:Name="LegacyConnectButton" Content="使用旧版配对码" Click="ConnectLegacyCloud" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="选择网关，自动配置远程唤醒" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="让这台电脑与家中网关连接同一路由器，在网页选择网关即可。程序会自动识别并保存唤醒信息，通常约 30 秒完成。" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="16" Margin="0,16,0,12">
                  <TextBlock Text="手机 / 浏览器  →  Cloud  →  家中网关  →  电脑" TextAlignment="Center" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="GatewayDetail" Text="正在检测唤醒网关状态。" Style="{StaticResource Caption}"/>
                <Button x:Name="GatewaySetupButton" Content="选择唤醒网关" Click="OpenGatewaySetup" HorizontalAlignment="Left" Margin="0,16,0,12"/>
                <TextBlock Text="首次使用请将 Windows、Cloud 和网关升级到支持自动配置的版本。电脑的 BIOS / 网卡仍需开启网络唤醒；建议使用有线连接。" Style="{StaticResource Caption}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="NetworkView" Visibility="Collapsed">
            <Border Style="{StaticResource Section}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="选择这台电脑的局域网连接" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="选择手机可以访问的物理网卡，推荐使用有线网络。" Style="{StaticResource Caption}" Margin="0,0,0,18"/>
                <TextBlock Text="局域网网卡" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ComboBox x:Name="AdapterBox" DisplayMemberPath="Label" SelectedValuePath="Id" Margin="0,0,0,18" AutomationProperties.Name="局域网网卡"/>
                <CheckBox x:Name="AutomaticNetworkBox" Content="地址变化时，自动更新这张网卡的局域网连接" IsChecked="True" Margin="0,0,0,12"/>
                <TextBlock Text="自动更新跟随所选网卡。切换网卡或地址后，请让手机重新扫码确认。关闭后使用固定地址配置。" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                <WrapPanel>
                  <Button x:Name="SaveNetworkButton" Content="保存网络设置" Click="SaveNetwork" Margin="0,0,10,8"/>
                  <Button x:Name="RefreshNetworkButton" Content="重新检测网络" Click="RefreshNetwork" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"/>
                  <Button Content="Windows 网络设置" Click="OpenNetworkSettings" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
                </WrapPanel>
                <TextBlock x:Name="NetworkNotice" Text="正在读取网络配置…" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="#EAF0F4" CornerRadius="8" Padding="20">
              <StackPanel>
                <TextBlock Text="网络与唤醒是两个条件" FontWeight="SemiBold"/>
                <TextBlock Text="Wi-Fi 可以控制在线电脑。能否从睡眠、休眠或关机唤醒，还取决于主板、网卡、驱动和电源设置，需要实测。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="LogsView" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <Grid Margin="0,0,0,18">
                  <StackPanel><TextBlock Text="服务运行日志" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="用于检查连接、配对和网络配置问题" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
                  <Button x:Name="RefreshLogsButton" Content="刷新日志" Click="ShowLogs" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Background="#F5F8FA"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="345" AutomationProperties.Name="服务日志"/>
                <TextBlock x:Name="LogNotice" Text="服务未连接时，可打开 Windows 服务管理查看 LanPower Service。" Style="{StaticResource Caption}" Margin="0,16,0,12"/>
                <WrapPanel><Button Content="Windows 服务管理" Click="OpenServices" Style="{StaticResource SecondaryButton}" Margin="0,0,10,8"/><Button Content="复制日志" Click="CopyLogs" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="SettingsView" Visibility="Collapsed">
            <Border Style="{StaticResource Section}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="窗口与托盘" Style="{StaticResource SectionTitle}"/>
                <CheckBox x:Name="CloseToTrayBox" Content="关闭窗口时，收起到系统托盘" IsChecked="True" Checked="SavePreferences" Unchecked="SavePreferences"/>
                <TextBlock Text="双击托盘图标可重新打开。托盘菜单可直接进入手机配对、查看日志或退出界面。后台服务独立运行。" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                <TextBlock x:Name="PreferencesNotice" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="版本与更新" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="VersionNotice" Text="当前桌面版本 1.6.1" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <WrapPanel><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdates" Margin="0,0,10,8"/><Button x:Name="OpenReleaseButton" Content="打开下载页面" Click="OpenRelease" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel>
                <CheckBox x:Name="UpdateProxyBox" Content="更新检查使用系统代理" IsChecked="True" Checked="SavePreferences" Unchecked="SavePreferences" Margin="0,10,0,0"/>
                <TextBlock Text="检查本项目的正式发布版本，由你下载并安装。" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <StackPanel Orientation="Horizontal"><Image Source="Assets/LanPower.png" Width="42" Height="42" Margin="0,0,14,0"/><StackPanel><TextBlock Text="LanPower" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Windows 电脑电源管理" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></StackPanel>
                <TextBlock Text="局域网控制 · 云端连接 · 可选远程唤醒" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="32,12" Background="White">
        <Grid><TextBlock x:Name="FooterNotice" Text="正在读取服务状态…" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="LastRefresh" Text="等待服务连接" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
