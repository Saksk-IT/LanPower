<Window x:Class="LanPower.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanPower" Width="740" Height="770" MinWidth="620" MinHeight="600"
        Background="#F2F6F6" FontFamily="Segoe UI" Foreground="{StaticResource Ink}"
        Loaded="OnLoaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,26,32,28">
      <DockPanel Margin="0,0,0,20">
        <TextBlock Text="LanPower" FontSize="30" FontWeight="Bold" DockPanel.Dock="Left"/>
        <TextBlock Text="Windows 1.4.0" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>

      <Border x:Name="FirstRunPanel" Background="#E2F3EF" CornerRadius="12" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="欢迎使用 LanPower" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="安装完成后，先检查局域网连接，再打开配对页面让手机扫码。Cloud 可跳过，局域网功能照常使用。"
                     TextWrapping="Wrap" Margin="0,8,0,15"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="打开手机配对" Click="OpenPairing"/>
            <Button Content="跳过 Cloud，开始使用" Click="FinishWelcome" Background="#456977"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="White" CornerRadius="12" Padding="22" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="DeviceName" Text="我的电脑" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="DeviceState" Text="正在连接服务…" Foreground="{StaticResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          </DockPanel>
          <TextBlock Text="连接" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="局域网"/><TextBlock x:Name="LanState" Grid.Row="0" Grid.Column="1" Text="检测中"/>
            <TextBlock Grid.Row="1" Text="Cloud"/><TextBlock x:Name="CloudState" Grid.Row="1" Grid.Column="1" Text="未配置"/>
            <TextBlock Grid.Row="2" Text="Wake Gateway"/><TextBlock x:Name="GatewayState" Grid.Row="2" Grid.Column="1" Text="未配置"/>
          </Grid>
          <TextBlock Text="网络" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="IP"/><TextBlock x:Name="LanIp" Grid.Row="0" Grid.Column="1" Text="—"/>
            <TextBlock Grid.Row="1" Text="MAC"/><TextBlock x:Name="Mac" Grid.Row="1" Grid.Column="1" Text="—"/>
            <TextBlock Grid.Row="2" Text="Wake-on-LAN"/><TextBlock x:Name="WolState" Grid.Row="2" Grid.Column="1" Text="检测中"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border Background="White" CornerRadius="12" Padding="22" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="远程控制" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="连接 Cloud 后，可在浏览器中直接控制这台电脑。未配置唤醒网关时，远程唤醒不可用。"
                     Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
          <TextBlock Text="输入 Cloud 地址，连接后在网页核对这台电脑的配对码并批准。" TextWrapping="Wrap"/>
          <TextBlock Text="Cloud 地址" Margin="0,12,0,4"/>
          <TextBox x:Name="CloudUrlBox" Text="https://"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="CloudConnectButton" Content="连接 Cloud" Click="ConnectCloud"/>
            <Button Content="打开 Cloud 网页" Click="OpenCloud" Background="#456977"/>
            <Button x:Name="CloudDisconnectButton" Content="断开 Cloud" Click="DisconnectCloud" Background="#456977" IsEnabled="False"/>
          </StackPanel>
          <TextBlock x:Name="CloudNotice" Margin="0,10,0,0" TextWrapping="Wrap"/>
          <StackPanel x:Name="CloudPairingPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock Text="设备配对码（10 分钟内有效）"/>
            <TextBox x:Name="CloudUserCode" IsReadOnly="True" FontFamily="Consolas" FontSize="26" Margin="0,6,0,10"/>
            <TextBlock Text="在 Cloud 网页输入此配对码，确认设备名称一致，再点击允许连接。" TextWrapping="Wrap"/>
            <Button Content="停止等待" Click="CancelCloudWait" HorizontalAlignment="Left" Margin="0,10,0,0" Background="#456977"/>
          </StackPanel>
          <Expander Header="连接旧版 Cloud" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="仅当旧版 Cloud 要求在网页生成一次性配对码时使用。" TextWrapping="Wrap" Margin="0,8,0,6"/>
              <PasswordBox x:Name="CloudCodeBox"/>
              <Button x:Name="LegacyConnectButton" Content="使用旧版配对码" Click="ConnectLegacyCloud" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <Button Content="打开手机配对" Click="OpenPairing"/>
        <Button Content="刷新状态" Click="RefreshStatus" Background="#456977"/>
        <Button Content="查看日志" Click="ShowLogs" Background="#456977"/>
      </StackPanel>
      <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
        <Expander x:Name="SettingsExpander" Header="设置与更新" Expanded="LoadSettings">
          <StackPanel Margin="0,12,0,0">
            <TextBlock Text="选择局域网网卡" FontWeight="SemiBold"/>
            <ComboBox x:Name="AdapterBox" DisplayMemberPath="Label" SelectedValuePath="Id" Margin="0,8,0,10"/>
            <CheckBox x:Name="AutomaticNetworkBox" Content="地址变化时，自动更新这张网卡的局域网连接" IsChecked="True" Margin="0,0,0,10"/>
            <TextBlock Text="自动更新只跟随所选物理网卡。切换网卡或地址后，请用手机重新扫码确认配对地址。Wi-Fi 可以控制电脑，能否唤醒仍需实测。"
                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
            <WrapPanel>
              <Button x:Name="SaveNetworkButton" Content="保存网络设置" Click="SaveNetwork"/>
              <Button x:Name="RefreshNetworkButton" Content="重新检测网络" Click="RefreshNetwork" Background="#456977"/>
              <Button Content="Windows 网络设置" Click="OpenNetworkSettings" Background="#456977"/>
            </WrapPanel>
            <TextBlock x:Name="NetworkNotice" TextWrapping="Wrap" Margin="0,8,0,12"/>
            <Separator Margin="0,0,0,12"/>
            <TextBlock x:Name="VersionNotice" Text="当前版本 1.4.0" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdates"/>
              <Button x:Name="OpenReleaseButton" Content="打开下载页面" Click="OpenRelease" IsEnabled="False" Background="#456977"/>
            </WrapPanel>
            <CheckBox x:Name="UpdateProxyBox" Content="更新检查使用系统代理" IsChecked="True" Margin="0,8,0,0"/>
            <TextBlock Text="更新由你下载并安装。检查更新只读取公开发布信息，不会发送 Cloud 或局域网连接信息。"
                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
          </StackPanel>
        </Expander>
      </Border>
      <Border x:Name="LogPanel" Background="White" CornerRadius="12" Padding="18" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="服务日志" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="150"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
