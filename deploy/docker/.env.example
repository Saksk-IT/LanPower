LANPOWER_DOMAIN=power.example.com
LANPOWER_PUBLIC_URL=https://${LANPOWER_DOMAIN}
# New deployments include Caddy for automatic HTTPS.
# Leave empty when using an existing HTTPS reverse proxy.
COMPOSE_PROFILES=https
# New deployments use a Docker volume with the image's data directory permissions.
# Existing ./data installations must keep ./data here (or omit this setting).
LANPOWER_DATA_MOUNT=cloud-data
# New installations create a Passkey through /setup. No password is required.
# Existing deployments may keep their password hash as a fallback:
# LANPOWER_ADMIN_PASSWORD_HASH='COPY_OUTPUT_FROM_python_-m_cloud_app.password'
