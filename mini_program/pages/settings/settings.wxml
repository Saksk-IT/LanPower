<view class="app-shell">
  <view wx:if="{{feedback}}" class="feedback feedback-{{feedbackKind}}" role="alert">
    <text class="feedback-copy">{{feedback}}</text>
    <button class="feedback-close" bindtap="dismissFeedback" aria-label="关闭提示">×</button>
  </view>

  <view class="page-content">
    <view class="page-heading me-heading"><view class="me-avatar"><view class="me-avatar-head"></view><view class="me-avatar-body"></view></view><view><view class="page-title">我的</view><view class="page-subtitle">{{environmentLabel}} · 授权与连接设置</view></view></view>
    <view wx:if="{{development}}" class="setting-card development-settings">
      <view class="setting-heading"><view class="setting-heading-copy"><view class="setting-title">开发版 Cloud 地址</view><view class="setting-copy">填写本机或测试服务器地址。开发版授权与正式版独立保存。</view></view><view class="setting-state warning-text">开发版</view></view>
      <label class="field-label" for="development-cloud">测试 Cloud 地址</label>
      <input id="development-cloud" value="{{cloudUrlDraft}}" bindinput="editCloudUrl" placeholder="https://电脑局域网IP:8443" maxlength="300" disabled="{{busy || updatingList || testingCloud}}" />
      <view class="field-help">手机请填电脑的局域网 HTTPS 地址，并连接同一 Wi-Fi。模拟器可使用 localhost。</view>
      <button class="outline-button compact-button" bindtap="testCloudConnection" loading="{{testingCloud}}" disabled="{{busy || updatingList || testingCloud || !cloudUrlDraft}}">测试连接</button>
      <button class="outline-button compact-button" bindtap="saveDevelopmentCloud" disabled="{{busy || updatingList || testingCloud || !cloudUrlDraft}}">保存测试地址</button>
      <button wx:if="{{developmentCloud}}" class="text-button centered-button" bindtap="clearDevelopmentCloud" disabled="{{busy || updatingList || testingCloud}}">清空地址，下次扫码选择</button>
      <view class="setting-copy">手机预览须单独核查微信调试设置和证书。授权二维码也要在填写地址的网页生成。</view>
      <view class="setting-copy">保存后请扫描该测试 Cloud 生成的手机授权码。换地址会切换授权和电脑列表。</view>
    </view>
    <view class="setting-card">
      <view class="setting-heading"><view class="setting-heading-copy"><view class="setting-title">手机授权</view><view class="setting-copy">连接 Cloud 后，在“我的设备”查看和控制已授权的电脑。</view></view><view class="setting-state {{cloudState == 'online' ? 'success-text' : needsReauthorize ? 'warning-text' : 'muted-text'}}">{{cloudStatusText}}</view></view>
      <view wx:if="{{connected}}" class="setting-row"><text>Cloud 地址</text><text class="setting-value">{{cloudHost}}</text></view>
      <button class="{{connected && !needsReauthorize ? 'outline-button' : 'primary-button'}} compact-button" bindtap="scanCloud" loading="{{busy}}" disabled="{{busy}}">{{connected ? '重新扫描授权码' : '扫描 Cloud 授权码'}}</button>
      <view class="setting-copy">在 Cloud 网页 → 已授权客户端生成二维码，并为这部手机开启 Codex Remote 权限。电源权限单独授权。</view>
    </view>
    <button class="list-card list-button" bindtap="openDevices"><view class="list-content"><view class="list-title">我的设备</view><view class="list-copy">查看已连接的设备，进入设备详情</view></view><text class="chevron">›</text></button>
    <button class="list-card list-button" bindtap="openHelp"><view class="list-content"><view class="list-title">使用帮助</view><view class="list-copy">Codex 接入、手机授权与电脑唤醒指引</view></view><text class="chevron">›</text></button>
    <button class="list-card list-button legacy-card" bindtap="openLocal"><view class="list-content"><view class="list-title">独立局域网 / 旧版连接</view><view class="list-copy">无需 Cloud 的直连模式，也兼容已有 v1 远程配对</view></view><text class="chevron">›</text></button>
    <view class="about-copy">CodexDock · {{environmentLabel}} · 小程序 v{{version}}</view>
    <button wx:if="{{connected}}" class="danger-link" bindtap="disconnect" disabled="{{busy}}">{{needsReauthorize ? '移除失效授权' : '撤销这部手机的授权'}}</button>
  </view>

</view>
