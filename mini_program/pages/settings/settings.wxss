@import "../../styles/device.wxss";

.me-heading { display:flex;align-items:center;gap:24rpx;margin-bottom:36rpx; }
.me-avatar { display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;width:108rpx;height:108rpx;border-radius:32rpx;background:var(--primary-soft);color:var(--primary);flex-shrink:0; }
.me-avatar-head { width:24rpx;height:24rpx;border:4rpx solid currentColor;border-radius:50%; }
.me-avatar-body { width:48rpx;height:24rpx;border:4rpx solid currentColor;border-radius:32rpx 32rpx 10rpx 10rpx; }
