.cr-card-title { display:block;font-size:16px;font-weight:600;margin-bottom:8px;word-break:break-word; }.cr-card-description { display:block;font-size:13px;color:var(--cr-muted);white-space:pre-wrap; }
.cr-card-actions { gap:8px;margin-top:14px; }.cr-card-actions .cr-primary,.cr-card-actions .cr-outline { flex:1;min-width:0;font-size:12px; }
.cr-feature-note { display:block;font-size:12px;color:var(--cr-muted);line-height:1.6;padding:10px 0;word-break:break-word; }
.cr-panel-error { display:block;padding:8px 18px;color:#c45c5c;font-size:12px; }
.cr-file-context { display:flex;flex-wrap:wrap;padding:8px 12px 0; }.cr-file-context .cr-text { max-width:100%;word-break:break-all; }
.codex-page button.cr-file-row { width:100%;gap:10px;justify-content:flex-start;text-align:left;font-size:13px;padding:12px 6px;border-bottom:1px solid var(--cr-line); }.cr-file-row text:nth-child(2) { flex:1;min-width:0;word-break:break-all; }.cr-file-glyph { font-size:22px;color:var(--cr-muted); }
.cr-file-content { display:block;padding-top:10px;font-size:12px; }.cr-file-preview .cr-card-title { margin-top:16px;font-size:13px; }
.cr-settings-section { margin-bottom:16px;border-bottom:1px solid var(--cr-line);padding-bottom:16px; }.cr-setting-options { display:flex;gap:6px;flex-wrap:wrap; }.cr-setting-options .cr-outline { width:auto;flex:1;min-width:64px;font-size:12px; }.cr-setting-row { justify-content:space-between;gap:10px;padding:12px 0;font-size:13px; }.cr-setting-row>text { flex:1;min-width:0;word-break:break-word; }
.cr-overlay { position:absolute;top:0;left:0;right:0;bottom:0;z-index:20;background:rgba(0,0,0,.36);display:flex;align-items:flex-end; }
.cr-sheet { background:var(--cr-bg);width:100%;max-height:94%;overflow-y:auto;border-radius:24px 24px 0 0;padding:9px 20px calc(20px + env(safe-area-inset-bottom));box-shadow:0 -6px 30px rgba(0,0,0,.08); }.cr-keyboard-open .cr-sheet { padding-bottom:12px; }
.cr-sheet-handle { width:34px;height:4px;background:var(--cr-line);border-radius:4px;margin:0 auto 8px; }
.cr-sheet-heading { justify-content:space-between;gap:12px;margin-bottom:10px;font-size:17px;font-weight:600; }.cr-sheet-heading>text { flex:1;min-width:0;word-break:break-word; }
.cr-sheet-scroll { height:50vh;max-height:480px; }.cr-keyboard-open .cr-sheet-scroll { height:31vh; }.cr-sheet-scroll .cr-feature-note { padding-top:0; }
.codex-page button.cr-sheet-row { width:100%;justify-content:space-between;flex-wrap:wrap;gap:4px;min-height:44px;padding:11px 10px;text-align:left;border-radius:9px; }.cr-sheet-row .cr-muted { width:100%;font-size:10px;word-break:break-all; }
.cr-sheet-input { height:44px;padding:10px 12px;background:var(--cr-surface);border:1px solid var(--cr-line);border-radius:10px;font-size:14px;margin-bottom:14px;width:100%; }
.cr-option-label { display:block;font-size:12px;font-weight:600;color:var(--cr-muted);padding:16px 8px 8px; }
.cr-detail-text { font-size:14px; }.cr-detail-scroll { height:52vh; }
.cr-approval-detail { display:block;background:var(--cr-surface);border-radius:12px;padding:12px;font-size:12px; }.cr-approval-cwd { display:block;padding-bottom:8px;word-break:break-all; }
.cr-question { padding:12px 0; }.cr-question>text { display:block;margin-bottom:8px; }
.codex-page button.cr-answer-option { width:100%;flex-direction:column;align-items:flex-start;gap:4px;text-align:left;border:1px solid var(--cr-line);margin-bottom:7px;padding:12px;font-size:13px; }.cr-answer-option .cr-muted { font-size:11px; }
.cr-answer-input { width:100%;height:72px;background:var(--cr-surface);border:1px solid var(--cr-line);border-radius:10px;padding:9px 12px;font-size:13px;margin:10px 0; }
.cr-approval-actions { gap:10px;padding-top:12px; }.cr-approval-actions .cr-primary { flex:2; }.cr-approval-actions .cr-outline { flex:1; }
@media (max-width:350px) { .cr-chat-scroll {padding-left:14px;padding-right:14px}.cr-composer-area {padding-left:9px;padding-right:9px}.cr-composer-tools .cr-model-pill {max-width:98px}.cr-sheet {padding-left:16px;padding-right:16px}.cr-composer-tools .cr-icon {width:28px}.cr-send {padding-left:8px;padding-right:8px}.cr-model-pill {font-size:9px} }

