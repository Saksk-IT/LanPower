.cr-advanced-row>view { display:flex;align-items:center;gap:8px;min-width:0; }.cr-advanced-row>view>text:first-child { overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.cr-option-chevron { font-size:10px;line-height:6px;display:flex;flex-direction:column; }.cr-option-chevron>text { margin-top:1px; }
.cr-speed-group { margin:22px 0 10px; }.cr-speed-group .cr-muted { font-size:10px; }
.cr-advanced-footer { display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:10px;color:var(--cr-muted);margin-top:10px; }
.codex-page button.cr-model-option { width:100%;padding:14px 8px;min-height:60px;justify-content:space-between;text-align:left;gap:10px;border-bottom:1px solid var(--cr-line);border-radius:0; }
.cr-model-option>view { flex:1;min-width:0; }.cr-model-option>view>text { display:block; }.cr-model-option .cr-muted { font-size:12px;margin-top:4px; }
.cr-sheet-effort { position:absolute;bottom:128px;left:22px;right:22px;width:auto;border:1px solid var(--cr-line);border-radius:30px;padding:14px 18px 18px; }
.cr-sheet-effort .cr-sheet-heading { font-size:17px; }.cr-sheet-effort .cr-sheet-handle { display:none; }
.cr-effort-track { position:relative;display:flex;align-items:center;justify-content:space-between;padding:0;height:48px;border-radius:28px;background:var(--cr-surface);border:1px solid var(--cr-line); }
.cr-effort-track-bg { position:absolute;left:16px;right:16px;top:12px;bottom:12px;background:var(--cr-line);border-radius:18px; }
.cr-effort-track-fill { position:absolute;left:0;top:0;bottom:0;max-width:100%;border-radius:28px;background:#315ff5; }
.codex-page button.cr-effort-dot { flex:1;width:auto;min-width:0;height:44px;min-height:44px;padding:0;background:transparent;z-index:1;border-radius:50%; }
.cr-effort-dot>view { width:7px;height:7px;background:#b8babe;border-radius:50%; }.cr-effort-dot.is-passed>view { background:#81a0fc; }
.cr-effort-dot.is-selected>view { width:34px;height:34px;background:#fff;box-shadow:0 1px 6px rgba(0,0,0,.14); }
.cr-effort-labels { display:flex;margin-top:10px;font-size:10px;color:var(--cr-muted); }.cr-effort-labels>text { flex:1;text-align:center; }.cr-effort-labels .is-selected { color:var(--cr-text);font-weight:600; }
.cr-effort-selector { margin:12px 0 18px; }
.cr-effort-slider { display:block;margin:12px 14px 4px; }
.codex-page .cr-effort-labels button.cr-effort-dot { font-size:11px;color:var(--cr-muted);height:36px;min-height:36px;border-radius:10px; }
.codex-page .cr-effort-labels button.cr-effort-dot.is-selected { color:var(--cr-text);background:var(--cr-surface);font-weight:600; }
.codex-page button.cr-advanced-status { width:100%;margin-top:12px; }
.cr-history-loading { text-align:center;padding:8px;color:var(--cr-muted);font-size:12px; }
.cr-chat-page .cr-message-user.cr-user-images { background:transparent;padding:0; }
.cr-user-images .cr-image-previews { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:0 0 10px;max-width:288px; }
.codex-page .cr-user-images .cr-image-previews button.cr-image-button { width:100%;height:140px;background:var(--cr-surface); }
.cr-user-images .cr-message-text { background:var(--cr-surface);border-radius:22px;padding:11px 15px; }
.cr-sheet-permissions,.cr-sheet-attachments,.cr-sheet-menu { position:absolute;display:flex;flex-direction:column;border:1px solid var(--cr-line);border-radius:28px;background:var(--cr-bg);box-shadow:0 14px 45px rgba(0,0,0,.14);padding:14px 16px; }
.cr-sheet-permissions { bottom:118px;left:12px;width:calc(100% - 24px);max-width:420px;max-height:calc(100% - 145px); }
.cr-sheet-permissions .cr-sheet-heading { font-size:14px;color:var(--cr-muted);margin-bottom:0; }
.cr-sheet-permissions .cr-sheet-handle,.cr-sheet-attachments .cr-sheet-handle,.cr-sheet-menu .cr-sheet-handle { display:none; }
.codex-page button.cr-permission-help { min-height:24px;align-self:flex-start;text-decoration:underline;padding:0 0 8px; }
.cr-permission-scroll { height:272px;min-height:0;flex-shrink:1; }
.codex-page button.cr-permission-row { width:100%;justify-content:flex-start;gap:15px;text-align:left;min-height:65px;padding:9px 6px; }
.cr-permission-copy { min-width:0;flex:1; }.cr-permission-copy>text { display:block; }.cr-permission-copy>text:first-child { font-size:17px; }.cr-permission-copy>text:last-child { color:var(--cr-muted);font-size:12px;margin-top:1px; }
.cr-permission-check { width:20px;flex-shrink:0;font-size:22px; }
.cr-sheet-attachments { left:12px;bottom:105px;width:calc(100% - 66px);max-width:360px;max-height:calc(100% - 125px);padding:12px 14px; }
.cr-sheet-attachments .cr-sheet-heading { font-size:12px;color:var(--cr-muted);margin-bottom:4px; }
.cr-attachment-menu-scroll { height:450px;min-height:0;flex-shrink:1; }
.codex-page button.cr-attachment-menu-row,.cr-attachment-unavailable { width:100%;min-height:58px;justify-content:flex-start;display:flex;align-items:center;gap:14px;padding:7px 10px;text-align:left;font-size:17px; }
.cr-attachment-menu-row>text:first-of-type { flex:1; }.cr-attachment-icon { width:36px;height:36px;border-radius:50%;background:var(--cr-surface);display:flex;align-items:center;justify-content:center;flex-shrink:0; }
.cr-attachment-unavailable { color:var(--cr-muted);font-size:16px; }.cr-attachment-unavailable>view>text { display:block; }.cr-attachment-unavailable .cr-muted { font-size:10px; }
.cr-attachment-section { display:block;color:var(--cr-muted);font-size:11px;padding:14px 10px 3px; }
.cr-sheet-menu { top:calc(var(--cr-status-top) + var(--cr-nav-height) + 6px);right:12px;bottom:auto;width:calc(100% - 76px);max-width:340px;max-height:calc(100% - var(--cr-status-top) - var(--cr-nav-height) - 20px); }
.cr-sheet-menu .cr-sheet-heading { font-size:12px;color:var(--cr-muted);font-weight:400;margin-bottom:0; }
.cr-thread-menu-scroll { height:430px;min-height:0;flex-shrink:1; }
.codex-page button.cr-chat-menu-row { width:100%;min-height:44px;justify-content:flex-start;text-align:left;gap:15px;padding:8px 10px;font-size:16px; }
.cr-chat-menu-divider { height:1px;background:var(--cr-line);margin:8px 10px; }.cr-menu-danger { color:#e65e63; }
.cr-changes-summary { display:flex;align-items:center;gap:12px;font-size:13px;padding:4px 8px 14px; }
.codex-page button.cr-change-file { display:flex;gap:8px;width:100%;text-align:left;min-height:56px;padding:12px 4px;font-size:12px;border-bottom:1px solid var(--cr-line);border-radius:0; }
.cr-change-file-name { flex:1;min-width:0; }.cr-change-file-name>text { display:block;word-break:break-all; }
.cr-status-section { padding:12px 0;border-bottom:1px solid var(--cr-line); }
.cr-file-browser,.cr-sheet-files { display:flex;flex-direction:column;min-height:0; }.cr-file-browser { flex:1;padding:4px 16px 16px; }
.cr-sheet-files { height:85%;padding-bottom:calc(14px + env(safe-area-inset-bottom)); }
.cr-file-picker-context { display:flex;align-items:center;gap:8px;font-size:14px;min-height:32px; }.cr-file-picker-context picker { min-width:0;flex:1; }.cr-file-branch { margin-left:auto;color:var(--cr-muted);font-size:11px; }
.cr-file-breadcrumbs { white-space:nowrap;height:36px;flex-shrink:0; }.cr-file-breadcrumbs .cr-file-context { display:inline-flex;flex-wrap:nowrap;padding:0; }
.cr-file-picker-search { display:flex;align-items:center;gap:8px;background:var(--cr-surface);border-radius:13px;padding:0 12px;margin:8px 0 12px; }
.cr-file-picker-search .cr-search-input { flex:1;min-width:0;background:transparent; }
.cr-file-picker-scroll { flex:1;min-height:0;height:0; }
.codex-page button.cr-file-row { width:100%;gap:12px;border-bottom:1px solid var(--cr-line);border-radius:0;padding:10px 2px;text-align:left;min-height:58px;justify-content:flex-start; }
.cr-file-tile { width:34px;height:38px;border-radius:7px;background:var(--cr-surface);color:var(--cr-muted);display:flex;align-items:center;justify-content:center;flex-shrink:0; }.cr-file-tile.is-folder { color:#d5aa58; }
.cr-file-row-name { flex:1;min-width:0; }.cr-file-row-name>text { display:block;word-break:break-all; }.cr-file-row-name .cr-muted { font-size:10px;margin-top:2px; }.cr-file-row-arrow { margin-left:auto;color:var(--cr-muted); }
/* Small line icons are CSS shapes, so no font glyph or image download is required. */
.cr-ui-icon { display:block;position:relative;width:20px;height:20px;flex-shrink:0;color:inherit;box-sizing:border-box; }
.cr-ui-icon::before,.cr-ui-icon::after { content:"";position:absolute;box-sizing:border-box; }
.cr-ui-terminal { border:1.5px solid currentColor;border-radius:4px;height:16px; }.cr-ui-terminal::before { left:3px;top:4px;width:4px;height:4px;border-top:1.5px solid currentColor;border-right:1.5px solid currentColor;transform:rotate(45deg); }.cr-ui-terminal::after { left:10px;bottom:3px;width:5px;border-top:1.5px solid currentColor; }
.cr-ui-camera { border:1.8px solid currentColor;border-radius:4px;height:16px;margin-top:3px; }.cr-ui-camera::before { width:7px;height:7px;border:1.6px solid currentColor;border-radius:50%;left:5px;top:3px; }.cr-ui-camera::after { left:4px;top:-5px;width:9px;height:5px;border:1.6px solid currentColor;border-bottom:0;border-radius:3px 3px 0 0;background:var(--cr-bg); }
.cr-ui-photo { width:18px;height:16px;border:1.7px solid currentColor;border-radius:4px; }.cr-ui-photo::before { left:3px;top:3px;width:3px;height:3px;background:currentColor;border-radius:50%; }.cr-ui-photo::after { left:3px;bottom:2px;width:9px;height:6px;border-left:1.5px solid currentColor;border-top:1.5px solid currentColor;transform:rotate(45deg); }
.cr-ui-clip { width:11px;height:19px;border:2px solid currentColor;border-radius:7px;transform:rotate(20deg);margin-left:4px; }.cr-ui-clip::after { left:2px;top:2px;width:3px;height:10px;border:1px solid currentColor;border-radius:3px; }
.cr-ui-folder { height:15px;border:1.7px solid currentColor;border-radius:4px;margin-top:4px; }.cr-ui-folder::before { left:0;top:-5px;width:9px;height:5px;border:1.7px solid currentColor;border-bottom:0;border-radius:3px 3px 0 0; }.cr-ui-folder::after { left:0;right:0;top:4px;border-top:1.5px solid currentColor; }
.cr-ui-file { width:15px;height:19px;border:1.5px solid currentColor;border-radius:3px;margin-left:2px; }.cr-ui-file::before { left:3px;right:3px;top:6px;height:5px;border-top:1px solid currentColor;border-bottom:1px solid currentColor; }
.cr-ui-search { width:14px;height:14px;border:1.7px solid currentColor;border-radius:50%;margin-right:4px; }.cr-ui-search::after { width:7px;border-top:1.7px solid currentColor;right:-6px;bottom:-3px;transform:rotate(45deg); }
.cr-ui-compose { width:17px;height:17px;border:1.8px solid currentColor;border-top-color:transparent;border-radius:4px; }.cr-ui-compose::after { width:15px;height:5px;border:1.5px solid currentColor;right:-3px;top:1px;transform:rotate(-45deg);background:var(--cr-bg); }
.cr-ui-shield,.cr-ui-warning { width:17px;height:19px;border:1.8px solid currentColor;border-radius:7px 7px 10px 10px; }.cr-ui-shield::after { left:4px;top:6px;width:6px;height:4px;border-left:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(-45deg); }.cr-ui-warning::after { left:6px;top:4px;height:7px;border-left:1.8px solid currentColor; }.cr-ui-warning::before { left:6px;bottom:3px;width:2px;height:2px;background:currentColor;border-radius:50%; }
.cr-ui-copy { width:15px;height:15px;border:1.6px solid currentColor;border-radius:4px;margin-top:4px; }.cr-ui-copy::after { width:14px;height:14px;left:4px;top:-6px;border:1.6px solid currentColor;border-radius:4px; }
.cr-ui-archive { width:18px;height:16px;border:1.7px solid currentColor;border-radius:3px;margin-top:3px; }.cr-ui-archive::before { left:-2px;right:-2px;top:-4px;height:5px;border:1.5px solid currentColor;border-radius:2px;background:var(--cr-bg); }.cr-ui-archive::after { left:4px;top:5px;width:6px;border-top:1.5px solid currentColor; }
.cr-ui-book { width:20px;height:17px;border:1.5px solid currentColor;border-radius:3px 3px 6px 6px; }.cr-ui-book::after { top:0;bottom:0;left:8px;border-left:1.5px solid currentColor; }
.cr-ui-pin { width:11px;height:12px;border:1.6px solid currentColor;border-radius:3px;transform:rotate(35deg);margin-left:4px; }.cr-ui-pin::after { left:3px;top:10px;height:8px;border-left:1.5px solid currentColor; }
.cr-ui-branch { width:12px;height:16px;border-left:1.5px solid currentColor;border-bottom:1.5px solid currentColor;border-radius:0 0 0 6px; }.cr-ui-branch::after { left:-4px;top:-3px;width:6px;height:6px;border:1.5px solid currentColor;border-radius:50%; }.cr-ui-branch::before { right:-3px;bottom:-3px;width:6px;height:6px;border:1.5px solid currentColor;border-radius:50%; }
.cr-ui-goal,.cr-ui-tool,.cr-ui-settings { width:19px;height:19px;border:1.7px solid currentColor;border-radius:50%; }.cr-ui-goal::after,.cr-ui-settings::after,.cr-ui-tool::after { left:4px;top:4px;width:7px;height:7px;border:1.5px solid currentColor;border-radius:50%; }
.cr-ui-hand { width:14px;height:17px;border:1.7px solid currentColor;border-radius:5px 5px 7px 7px;transform:rotate(-10deg); }.cr-ui-hand::after { left:4px;top:1px;height:7px;border-left:1.2px solid currentColor; }
.cr-ui-plan { border-top:1.6px solid currentColor;border-bottom:1.6px solid currentColor;height:14px;margin:3px 0; }.cr-ui-plan::after { left:0;right:0;top:5px;border-top:1.6px solid currentColor; }
.cr-ui-refresh { width:17px;height:17px;border:1.6px solid currentColor;border-right-color:transparent;border-radius:50%; }.cr-ui-refresh::after { right:-2px;top:0;width:5px;height:5px;border-top:1.5px solid currentColor;border-right:1.5px solid currentColor; }
.cr-ui-spark::before { left:8px;top:1px;bottom:1px;border-left:1.5px solid currentColor; }.cr-ui-spark::after { left:1px;right:1px;top:8px;border-top:1.5px solid currentColor; }
.cr-home-composer { margin-bottom:calc(12px + env(safe-area-inset-bottom)); }
.cr-keyboard-open .cr-home-composer { margin-bottom:12px; }
