/* Conversation detail follows the iOS reference while retaining native WeChat controls. */
.cr-chat-page .cr-header { border-bottom:0; }
.cr-chat-page button.cr-back { width:36px;height:36px;min-height:36px;border:1px solid var(--cr-line);border-radius:50%;font-size:30px; }
.cr-chat-page .cr-title { font-size:16px;letter-spacing:-.2px; }
.cr-chat-page .cr-subtitle { font-size:10px;margin-top:1px; }
.cr-header-actions { display:flex;border:1px solid var(--cr-line);border-radius:24px;padding:0 2px;flex-shrink:0; }
.cr-header-actions button.cr-icon { width:32px;height:32px;min-height:32px; }
.cr-chat-page .cr-chat-scroll { padding:18px 16px 0; }
.cr-chat-page .cr-message-assistant { margin-bottom:22px; }
.cr-chat-page .cr-markdown,.cr-chat-page .cr-message-text { font-size:16px;line-height:1.7; }
.cr-chat-page .cr-message-user { margin-left:40px;border-radius:22px;padding:11px 15px; }
.cr-chat-page .cr-message-actions { margin-top:8px;opacity:.75; }
.cr-chat-page .cr-message-work { margin:18px 0 10px; }
.cr-chat-page .cr-work-elapsed { font-size:14px;color:var(--cr-muted);padding:4px 0 10px; }
.codex-page button.cr-work-row { display:flex;flex-direction:column;align-items:flex-start;gap:8px;width:100%;padding:0;background:transparent;color:var(--cr-muted);font-size:14px;text-align:left; }
.cr-work-summary { display:flex;align-items:center;gap:8px;width:100%;padding:9px 0;border-top:1px solid var(--cr-line); }
.cr-work-summary>text:first-of-type { flex:1;min-width:0;white-space:normal; }
.codex-page button.cr-activity-group,.codex-page button.cr-activity-toggle,.codex-page button.cr-reasoning-toggle { width:100%;justify-content:flex-start;gap:8px;background:transparent;color:var(--cr-muted);font-size:14px;text-align:left;min-height:34px;padding:3px 0;border-radius:0; }
.cr-row-label { min-width:0;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.cr-row-chevron { flex-shrink:0;font-size:20px;line-height:1;color:var(--cr-muted); }
.cr-chat-page .cr-message-activity,.cr-chat-page .cr-message-activityGroup { margin-bottom:6px; }
.cr-chat-page .cr-activity-card { border:0;padding:0;border-radius:0; }
.cr-activity-detail { border:1px solid var(--cr-line);border-radius:14px;padding:12px;margin:8px 0 14px;background:var(--cr-surface); }
.cr-activity-failed { color:#dc6c42;font-size:15px; }
.cr-chat-page .cr-reasoning { border:0;padding:0; }
.cr-reasoning-detail { display:block;padding:10px 12px;border-left:2px solid var(--cr-line);white-space:pre-wrap;line-height:1.65;font-size:13px; }
.cr-compaction { display:flex;align-items:center;gap:12px;color:var(--cr-muted);font-size:12px;padding:16px 0; }
.cr-compaction>view { height:1px;background:var(--cr-line);flex:1; }
.cr-message-error { border:1px solid #ecd7c3;border-radius:16px;background:#fff8f1;padding:12px 14px;color:#d67a37; }
.cr-dark .cr-message-error { background:#30251d;border-color:#624632;color:#efae7c; }
.codex-page button.cr-live { width:auto;max-width:100%;display:flex;align-items:center;gap:8px;margin:6px 0;padding:3px 0;color:var(--cr-muted);font-size:14px;justify-content:flex-start; }
.cr-live-work .cr-plan { border-left:1px solid var(--cr-line);padding:0 12px 8px;font-size:13px; }
.cr-chat-page .cr-thinking-dot { background:#7d8b9e;animation:cr-status-pulse 1.5s ease-in-out infinite; }
@keyframes cr-status-pulse { 50% { opacity:.35; } }
.cr-chat-page .cr-composer-area { padding:8px 12px calc(12px + env(safe-area-inset-bottom));background:transparent; }
.codex-page button.cr-changes-pill { width:fit-content;max-width:100%;min-height:32px;margin:0 auto 8px;border:1px solid var(--cr-line);border-radius:22px;gap:9px;padding:5px 14px;font-size:12px;background:var(--cr-bg);box-shadow:0 3px 14px rgba(0,0,0,.05); }
.cr-added { color:#489964; }.cr-removed { color:#d66a70; }
.cr-chat-page .cr-composer { border:1px solid var(--cr-line);border-radius:28px;box-shadow:0 3px 15px rgba(0,0,0,.035);padding:10px 12px 8px;background:var(--cr-surface);position:relative; }
.cr-chat-page .cr-textarea { min-height:44px;max-height:150px;padding:4px 4px 8px;font-size:16px;line-height:1.5; }
.cr-chat-page .cr-composer-toolbar { justify-content:space-between;gap:6px;margin:0; }
.cr-chat-page .cr-composer-tools,.cr-chat-page .cr-composer-send { gap:6px;min-width:0; }
.cr-chat-page button.cr-send,.cr-chat-page button.cr-stop { width:38px;min-width:38px;height:38px;min-height:38px;padding:0;border-radius:50%;background:#315ff5;color:#fff;font-size:27px;flex-shrink:0; }
.cr-stop-square { width:13px;height:13px;border-radius:2px;background:currentColor; }
.cr-chat-page button.cr-stop-secondary { background:transparent;color:var(--cr-muted);border:1px solid var(--cr-line);width:32px;height:32px;min-height:32px; }
.cr-chat-page .cr-composer-compact { padding:8px 50px 8px 45px;border-radius:32px;min-height:56px; }
.cr-chat-page .cr-composer-compact .cr-textarea { min-height:32px;max-height:44px;padding:5px 0; }
.cr-composer-compact .cr-composer-toolbar { position:absolute;left:7px;right:7px;top:8px;pointer-events:none; }
.cr-composer-compact .cr-composer-toolbar button { pointer-events:auto; }
.cr-composer-compact .cr-permission-button { display:none; }
.cr-composer-compact .cr-textarea { padding-right:94px; }
.cr-chat-page .cr-send-modes { margin:0;justify-content:flex-start;gap:10px; }
.cr-chat-page .cr-send-modes .cr-text { min-height:26px;font-size:11px;padding:3px 4px; }
.cr-composer-compact .cr-send-modes { display:none; }
.cr-permission-button.is-full-access { color:#e38238; }
.cr-context-ring { width:22px;height:22px;border-radius:50%;border:2px solid var(--cr-line);border-top-color:var(--cr-muted);display:flex;align-items:center;justify-content:center;color:var(--cr-muted); }
.cr-context-ring.has-context { border-top-color:#315ff5; }.cr-context-ring>text { font-size:8px;line-height:1; }
.cr-chat-page .cr-jump { bottom:140px;width:36px;height:36px;min-height:36px;left:50%;right:auto;transform:translateX(-50%);border-radius:50%;padding:0;font-size:19px; }
.cr-chat-page .cr-queue { border-radius:16px;margin-bottom:8px; }
.cr-chat-page .cr-setting-note { font-size:10px;line-height:1.4;padding:4px 8px 0; }
.cr-sheet-options,.cr-sheet-models,.cr-sheet-files,.cr-sheet-changes,.cr-sheet-status { border:1px solid var(--cr-line);border-radius:30px 30px 0 0; }
.cr-sheet-options { height:390px;max-height:88%;padding:12px 20px 24px; }
.cr-sheet-options .cr-sheet-heading { justify-content:center;margin:14px 0 24px;text-align:center; }
.cr-sheet-options .cr-sheet-heading .cr-icon { position:absolute;right:14px; }
.cr-advanced-group { background:var(--cr-surface);border-radius:24px;padding:0 18px; }
.codex-page button.cr-advanced-row,.cr-advanced-row { width:100%;min-height:57px;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 0;border-radius:0;font-size:16px; }
