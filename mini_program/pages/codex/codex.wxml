<view class="codex-page theme-{{theme}}" style="height: calc(100vh - {{keyboardHeight}}px);">
  <view wx:if="{{feedback}}" class="cr-feedback"><text>{{feedback}}</text><button class="cr-icon" bindtap="dismissFeedback" aria-label="关闭提示">×</button></view>

  <block wx:if="{{view == 'library'}}">
    <view class="cr-library-top">
      <picker wx:if="{{devices.length}}" range="{{devices}}" range-key="name" value="{{deviceIndex}}" bindchange="selectDevice">
        <view class="cr-device"><view class="cr-monitor"></view><text class="cr-device-name">{{deviceName}}</text><view class="cr-dot {{ready ? 'online' : ''}}"></view><text class="cr-muted">{{ready ? '在线' : '连接中'}}</text><text class="cr-chevron">⌄</text></view>
      </picker>
      <view wx:else class="cr-device"><view class="cr-monitor"></view><text>{{deviceName}}</text></view>
      <view class="cr-heading"><text>会话</text><button class="cr-icon cr-compose-icon" bindtap="openNew" disabled="{{!ready || busy}}" aria-label="新建会话"><view class="cr-compose"></view></button></view>
      <view class="cr-search"><view class="cr-search-icon"></view><input placeholder="搜索会话" placeholder-class="cr-placeholder" value="{{search}}" bindinput="search" maxlength="120" /></view>
      <view class="cr-filter-row"><picker range="{{projectOptions}}" range-key="name" value="{{projectIndex}}" bindchange="filterProject"><view class="cr-project-filter">{{projectOptions[projectIndex].name}}<text>⌄</text></view></picker><button class="cr-icon" bindtap="openOptions" aria-label="外观与模型选项"><view class="cr-settings"></view></button></view>
    </view>
    <scroll-view class="cr-library-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{!authorized}}" class="cr-empty"><view class="cr-empty-title">在微信里继续开发</view><view class="cr-empty-copy">连接你的电脑，随时查看 Codex 会话、跟进任务和确认修改。</view><button class="cr-primary" data-tab="connect" bindtap="navigate">连接开发电脑</button><view class="cr-empty-note">使用现有 Cloud 手机授权</view></view>
      <view wx:elif="{{!ready}}" class="cr-state-card"><view class="cr-state-title">{{devices.length ? stateTitle : loading ? '正在读取电脑' : '还没有开发电脑'}}</view><view class="cr-state-copy">{{devices.length ? stateHint : '请在 Windows 版 LanPower 连接同一个 Cloud。'}}</view><button class="cr-outline" bindtap="reconnect" loading="{{loading}}">重新连接</button><button class="cr-link" data-tab="connect" bindtap="navigate">连接设置</button></view>
      <view wx:if="{{sessions.length}}" class="cr-section-label">{{search ? '搜索结果' : '最近'}}</view>
      <button wx:for="{{sessions}}" wx:key="id" class="cr-session" data-id="{{item.id}}" bindtap="selectThread" disabled="{{!ready || busy}}">
        <view class="cr-session-copy"><view class="cr-session-title">{{item.name}}</view><view class="cr-session-meta">{{item.project}} · {{item.running ? '正在运行' : item.time}}{{item.desktop ? ' · 桌面' : ''}}</view></view><view wx:if="{{item.running}}" class="cr-dot online"></view><text class="cr-session-arrow">›</text>
      </button>
      <view wx:if="{{ready && !sessions.length}}" class="cr-empty"><view class="cr-empty-title">{{search ? '没有找到会话' : '开始新的开发任务'}}</view><view class="cr-empty-copy">{{search ? '试试其他名称，或加载更早的会话。' : '选择电脑上的项目，就能开始新会话。'}}</view></view>
      <button wx:if="{{hasMore}}" class="cr-link" bindtap="more">加载更早的会话</button>
      <view wx:if="{{ready && projects.length && !search}}" class="cr-project-section"><view class="cr-section-label">项目</view><button wx:for="{{projects}}" wx:key="path" class="cr-project-row" data-path="{{item.path}}" bindtap="createThread" disabled="{{busy}}"><view class="cr-folder"></view><text>{{item.name}}</text><text class="cr-project-plus">＋</text></button></view>
      <view class="cr-library-note">项目与会话保留在你的电脑</view>
    </scroll-view>
    <view class="cr-new-area"><button class="cr-primary" bindtap="openNew" disabled="{{!ready || busy || !projects.length}}"><text class="cr-plus-label">＋</text>新建会话</button></view>
    <view class="cr-tabs"><button class="cr-tab" data-tab="home" bindtap="navigate"><view class="cr-monitor"></view><text>电脑</text></button><button class="cr-tab selected"><view class="cr-chat-icon">···</view><text>Codex</text></button><button class="cr-tab" data-tab="connect" bindtap="navigate"><view class="cr-chain"></view><text>连接</text></button><button class="cr-tab" data-tab="help" bindtap="navigate"><view class="cr-help">?</view><text>帮助</text></button></view>
  </block>

  <block wx:else>
    <view class="cr-chat-heading"><button class="cr-icon cr-back" bindtap="back" aria-label="返回会话列表">‹</button><view class="cr-chat-title"><view>{{title}}</view><text>{{project}} · {{deviceName}}</text></view><button class="cr-icon" bindtap="openMenu" aria-label="会话菜单">···</button></view>
    <view class="cr-task-status"><view class="cr-dot {{running ? 'online' : ''}}"></view><text>{{taskState}}</text><text class="cr-elapsed">{{elapsed}}</text></view>
    <scroll-view class="cr-chat-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollTarget}}" scroll-with-animation="{{false}}" bindscroll="chatScroll" bindscrolltolower="reachedBottom" lower-threshold="80">
      <view wx:if="{{historyNotice}}" class="cr-library-note">显示近期内容，完整会话保留在电脑上的 Codex。</view>
      <view wx:if="{{!messages.length}}" class="cr-chat-empty"><view class="cr-empty-title">从这里开始</view><view class="cr-empty-copy">向 Codex 描述你要完成的工作。</view></view>
      <block wx:for="{{messages}}" wx:key="id">
        <view wx:if="{{item.kind == 'user'}}" class="cr-user"><text selectable>{{item.text}}</text></view>
        <view wx:elif="{{item.kind == 'assistant'}}" class="cr-assistant"><rich-text nodes="{{item.nodes}}" selectable user-select /></view>
        <view wx:else class="cr-turn-summary"><text>✓</text>{{item.text}}</view>
      </block>
      <view wx:if="{{running || activities.length || plan.length}}" class="cr-progress"><button class="cr-detail-button" bindtap="toggleProgress"><view class="cr-progress-symbol {{running ? 'spinning' : ''}}"></view><text>{{running ? '正在运行' : '执行过程'}}</text><text class="cr-detail-end">{{progressOpen ? '⌃' : '⌄'}}</text></button><view wx:if="{{progressOpen}}" class="cr-progress-body"><view wx:for="{{plan}}" wx:key="index" class="cr-plan"><text class="{{item.status == 'completed' ? 'cr-success' : 'cr-muted'}}">{{item.status == 'completed' ? '✓' : item.status == 'inProgress' ? '◌' : '·'}}</text><text>{{item.text}}</text></view><view wx:for="{{activities}}" wx:key="id" class="cr-activity">{{item.text}}</view><view wx:if="{{liveAction && running}}" class="cr-activity">{{liveAction}}</view></view></view>
      <view wx:if="{{files.length || added || removed}}" class="cr-files"><button class="cr-detail-button" bindtap="toggleDiff"><view class="cr-file-icon"></view><text>已修改 {{files.length}} 个文件</text><text class="cr-diff-count"><text class="cr-success">+{{added}}</text><text class="cr-danger">−{{removed}}</text></text><text>{{diffOpen ? '⌃' : '⌄'}}</text></button><view wx:if="{{diffOpen}}" class="cr-diff-body"><view wx:for="{{files}}" wx:key="path" class="cr-file-row"><text>{{item.path}}</text><text class="cr-success">+{{item.added}}</text><text class="cr-danger">−{{item.removed}}</text></view><text class="cr-patch" selectable>{{diffText}}</text></view></view>
      <button wx:for="{{approvals}}" wx:key="key" class="cr-approval-banner" data-key="{{item.key}}" bindtap="openApproval"><view><view class="cr-approval-label">{{item.label}}</view><view class="cr-muted">{{item.submitted ? '已提交，等待电脑确认' : '点击查看本次操作'}}</view></view><text>›</text></button>
      <view id="chat-end" class="cr-chat-end"></view>
    </scroll-view>
    <view class="cr-composer-area {{keyboardHeight ? 'keyboard-open' : ''}}"><button wx:if="{{showJump}}" class="cr-jump" bindtap="jump" aria-label="查看最新消息">↓</button><view wx:if="{{controlHint}}" class="cr-control-hint">{{controlHint}}</view><view class="cr-composer"><textarea class="cr-prompt" value="{{prompt}}" bindinput="input" bindkeyboardheightchange="keyboard" bindblur="keyboard" placeholder="{{placeholder}}" placeholder-class="cr-placeholder" maxlength="16000" auto-height adjust-position="{{false}}" show-confirm-bar="{{false}}" cursor-spacing="16" disabled="{{!ready || busy || desktop}}" /><view class="cr-composer-actions"><button class="cr-icon cr-plus" bindtap="openOptions" aria-label="模型与外观选项">＋</button><view class="cr-composer-spacer"></view><button wx:if="{{showStop}}" class="cr-send" bindtap="interrupt" disabled="{{!canInterrupt}}" aria-label="暂停任务"><view class="cr-stop"></view></button><button wx:else class="cr-send" bindtap="send" disabled="{{!canSend}}" aria-label="发送消息"><view class="cr-send-arrow"></view></button></view></view><view class="cr-composer-footnote">Codex Remote</view></view>
  </block>

  <view wx:if="{{sheet}}" class="cr-scrim" bindtap="closeSheet"><view class="cr-sheet" catchtap="noop"><view class="cr-sheet-handle"></view><view class="cr-sheet-heading"><view>{{sheet == 'approval' ? approval.title : sheet == 'project' ? '在哪个项目中开始？' : sheet == 'menu' ? '会话选项' : '模型与外观'}}</view><button class="cr-icon" bindtap="closeSheet" aria-label="关闭弹层">×</button></view><scroll-view class="cr-sheet-scroll" scroll-y>
    <block wx:if="{{sheet == 'project'}}"><view class="cr-sheet-copy">任务将在你选择的电脑项目中执行。</view><button wx:for="{{projects}}" wx:key="path" class="cr-project-row" data-path="{{item.path}}" bindtap="createThread" disabled="{{busy}}"><view class="cr-folder"></view><text>{{item.name}}</text><text class="cr-project-plus">＋</text></button><view wx:if="{{!projects.length}}" class="cr-sheet-copy">请先在电脑上授权至少一个项目。</view></block>
    <block wx:elif="{{sheet == 'options'}}"><view class="cr-sheet-label">模型</view><picker range="{{models}}" range-key="name" value="{{modelIndex}}" bindchange="model" disabled="{{running || busy}}"><view class="cr-model-picker">{{models[modelIndex].name}}<text>⌄</text></view></picker><view class="cr-sheet-label">外观</view><view class="cr-theme-options"><button class="cr-theme-option {{themeMode == 'system' ? 'active' : ''}}" data-value="system" bindtap="changeTheme">跟随系统</button><button class="cr-theme-option {{themeMode == 'light' ? 'active' : ''}}" data-value="light" bindtap="changeTheme">浅色</button><button class="cr-theme-option {{themeMode == 'dark' ? 'active' : ''}}" data-value="dark" bindtap="changeTheme">深色</button></view></block>
    <block wx:elif="{{sheet == 'menu'}}"><button class="cr-menu-row" bindtap="refreshSelected">刷新当前会话</button><button class="cr-menu-row" bindtap="copy">复制最新回复</button><button class="cr-menu-row" bindtap="release" disabled="{{!canRelease}}">交还桌面</button><button class="cr-menu-row" bindtap="openOptions">模型与外观</button><button class="cr-menu-row" bindtap="reconnect">重新连接电脑</button></block>
    <block wx:elif="{{sheet == 'approval'}}"><view class="cr-sheet-copy">{{approval.kind == 'file' ? 'Codex 请求修改当前项目中的文件。' : approval.kind == 'command' ? '请确认本次命令及执行目录。' : approval.kind == 'permission' ? '请确认当前任务的额外权限。' : approval.kind == 'local' ? '此工具需要在电脑上完成确认。' : '回答后 Codex 会继续当前任务。'}}</view><text wx:if="{{approval.detail}}" class="cr-approval-detail" selectable>{{approval.detail}}</text><view wx:for="{{approval.files}}" wx:key="path" class="cr-approval-file"><view class="cr-file-icon"></view><text>{{item.path}}</text></view><view wx:for="{{approval.questions}}" wx:key="id" class="cr-question"><view>{{item.text}}</view><input class="cr-answer" value="{{item.value}}" password="{{item.secret}}" placeholder="{{item.options || '填写回答'}}" maxlength="4000" data-index="{{index}}" bindinput="answer" disabled="{{approval.submitted}}" /></view><view class="cr-approval-scope">{{approval.submitted ? '已提交，等待电脑确认' : '仅本次操作 · 保留电脑端权限限制'}}</view><button wx:if="{{approval.kind == 'file' || approval.kind == 'command' || approval.kind == 'answer' || approval.kind == 'permission' && approval.network}}" class="cr-primary" data-allow="yes" bindtap="decide" disabled="{{approval.submitted || !ready}}">{{approval.kind == 'answer' ? '提交回答' : approval.kind == 'permission' ? '仅本次允许网络访问' : '仅本次允许'}}</button><button wx:if="{{approval.kind != 'answer'}}" class="cr-outline" data-allow="no" bindtap="decide" disabled="{{approval.submitted || !ready}}">{{approval.kind == 'local' ? '拒绝并在电脑处理' : '拒绝'}}</button></block>
  </scroll-view></view></view>
</view>
