<template name="effortSelector">
  <view class="cr-effort-selector">
    <slider class="cr-effort-slider" min="0" max="{{effortMax}}" step="1" value="{{sliderEffortIndex}}" disabled="{{!ready || effortChoices.length < 2}}" activeColor="#315ff5" backgroundColor="#e5e5e8" block-size="28" bindchanging="slideEffort" bindchange="slideEffort" aria-label="模型强度"/>
    <view class="cr-effort-labels"><button wx:for="{{effortChoices}}" wx:key="value" class="cr-effort-dot {{selectedEffort === item.value ? 'is-selected' : ''}}" disabled="{{!ready}}" data-value="{{item.value}}" aria-label="{{item.name}}" bindtap="chooseEffort">{{item.name}}</button></view>
    <text wx:if="{{!effortChoices.length}}" class="cr-feature-note">当前模型未提供可调强度</text>
  </view>
</template>
<template name="projectFiles">
  <view class="cr-file-picker-context"><view class="cr-ui-icon cr-ui-folder"></view><picker wx:if="{{projects.length > 1}}" range="{{projects}}" range-key="name" bindchange="selectFileProject"><view>{{fileProject || '选择项目'}} ⌄</view></picker><text wx:else>{{fileProject}}</text><text wx:if="{{fileState.branch}}" class="cr-file-branch">{{fileState.branch}}</text></view>
  <scroll-view class="cr-file-breadcrumbs" scroll-x="true"><view class="cr-file-context"><button class="cr-text" bindtap="fileRoot">项目</button><button wx:for="{{fileState.breadcrumbs}}" wx:key="path" class="cr-text" data-path="{{item.path}}" data-directory="{{true}}" bindtap="openFile">› {{item.name}}</button></view></scroll-view>
  <view class="cr-file-picker-search"><view class="cr-ui-icon cr-ui-search"></view><input class="cr-search-input" value="{{fileState.query}}" maxlength="256" placeholder="搜索文件和文件夹" bindinput="fileSearch"/></view>
  <text wx:if="{{fileState.error}}" class="cr-panel-error">{{fileState.error}}</text>
  <scroll-view class="cr-file-picker-scroll cr-feature-scroll" scroll-y="true">
    <view wx:if="{{fileState.loading}}" class="cr-empty-small">正在读取文件…</view>
    <view wx:if="{{fileState.selected}}" class="cr-file-preview">
      <view class="cr-card-actions"><button class="cr-outline" bindtap="fileBack">返回文件列表</button><button class="cr-primary" disabled="{{!canControl || fileState.loading}}" bindtap="attachFile">添加到聊天</button></view>
      <text class="cr-card-title">{{fileState.selected.path}}</text>
      <text wx:if="{{fileState.selected.binary}}" class="cr-feature-note">此文件可添加到聊天，预览请在电脑打开。</text><text wx:elif="{{fileState.selected.tooLarge}}" class="cr-feature-note">文件较大，请在电脑查看完整内容。</text><text wx:else class="cr-code cr-file-content" selectable="true">{{fileState.selected.content}}</text>
      <button wx:if="{{fileState.selected.hasMore}}" class="cr-text" bindtap="fileFull">查看完整文件内容</button>
    </view>
    <block wx:else>
      <button wx:if="{{fileState.directory !== '.' && !fileState.query}}" class="cr-file-row" bindtap="fileParent"><view class="cr-file-tile"><text>↰</text></view><text>上一级</text><text class="cr-file-row-arrow">›</text></button>
      <button wx:for="{{fileState.files}}" wx:key="path" class="cr-file-row" data-path="{{item.path}}" data-directory="{{item.directory}}" bindtap="openFile"><view class="cr-file-tile {{item.directory ? 'is-folder' : ''}}"><view class="cr-ui-icon {{item.directory ? 'cr-ui-folder' : 'cr-ui-file'}}"></view></view><view class="cr-file-row-name"><text>{{item.name}}</text><text wx:if="{{fileState.query}}" class="cr-muted">{{item.path}}</text></view><text class="cr-file-row-arrow">›</text></button>
      <text wx:if="{{!fileState.files.length && !fileState.loading}}" class="cr-empty-small">{{fileState.query ? '没有匹配的文件' : '此目录为空'}}</text>
      <view wx:if="{{fileHasPrevious || fileHasNext}}" class="cr-pagination"><button class="cr-text" disabled="{{!fileHasPrevious}}" data-direction="-1" bindtap="filePage">上一页</button><button class="cr-text" disabled="{{!fileHasNext}}" data-direction="1" bindtap="filePage">下一页</button></view>
      <button wx:if="{{fileState.cursor}}" class="cr-load-more" disabled="{{fileState.loading}}" bindtap="filesMore">读取更多文件</button><text wx:if="{{fileState.truncated}}" class="cr-feature-note">结果较多，可以输入更具体的文件名。</text>
    </block>
  </scroll-view>
</template>
<template name="threadRows">
  <button wx:for="{{rows}}" wx:key="id" class="cr-thread {{item.selected ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="selectThread" bindlongpress="openMenu">
    <view class="cr-thread-main"><text class="cr-thread-name">{{item.name}}</text><text wx:if="{{item.pending}}" class="cr-pending-dot">待回复</text><view wx:elif="{{item.running}}" class="cr-running-dot"></view></view>
    <text class="cr-thread-menu" data-id="{{item.id}}" catchtap="openMenu" aria-label="聊天操作">···</text>
  </button>
</template>
<template name="recentSection">
  <view class="cr-library-section cr-recent-section">
    <view class="cr-section-head"><button class="cr-section-title" bindtap="toggleRecent">{{homeOrder === 'priority' ? '优先级' : archived ? '已归档会话' : '最近'}}<view wx:if="{{recentCollapsed}}" class="cr-symbol cr-symbol-chevron"></view></button><button class="cr-icon cr-section-compose" disabled="{{!ready || busy}}" bindtap="openNew" aria-label="新建聊天"><view class="cr-symbol cr-symbol-compose"></view></button></view>
    <block wx:if="{{!recentCollapsed}}"><template is="threadRows" data="{{rows:recent}}"/><text wx:if="{{!recent.length}}" class="cr-empty-small">{{search ? '没有匹配的会话' : loading ? '正在读取会话…' : !ready ? '连接电脑后显示最近会话' : archived ? '还没有已归档会话' : libraryFilter === 'chats' ? '还没有独立聊天' : '从一个新会话开始'}}</text><button wx:if="{{!recentTimeline && recentHasNext}}" class="cr-recent-more" bindtap="showAllRecent">查看全部最近会话 <text>›</text></button><view wx:if="{{recentTimeline && (recentHasPrevious || recentHasNext)}}" class="cr-pagination"><button class="cr-text" disabled="{{!recentHasPrevious}}" data-direction="-1" bindtap="recentPage">上一组</button><button class="cr-text" disabled="{{!recentHasNext}}" data-direction="1" bindtap="recentPage">下一组</button></view></block>
  </view>
</template>
<view class="codex-page {{theme === 'dark' ? 'cr-dark' : ''}} {{keyboardHeight ? 'cr-keyboard-open' : ''}} {{view === 'chat' ? 'cr-chat-page' : ''}}" style="--cr-status-top:{{navigation.statusTop}}px;--cr-nav-height:{{navigation.height}}px;--cr-nav-right:{{navigation.right}}px;bottom:{{keyboardHeight}}px;">
  <view wx:if="{{view === 'library'}}" class="cr-library-top">
    <view class="cr-home-toolbar"><button wx:if="{{deviceLocked}}" class="cr-home-circle" data-page="power" bindtap="navigate" aria-label="返回设备详情">‹</button><button wx:else class="cr-home-circle" bindtap="toggleHomeMenu" aria-label="打开菜单" aria-expanded="{{homeMenu}}"><view class="cr-symbol cr-symbol-menu"></view></button><button class="cr-home-title" bindtap="toggleHomeMenu" aria-label="会话显示与设置" aria-expanded="{{homeMenu}}"><text>Codex</text><view class="cr-symbol cr-symbol-chevron"></view></button><button class="cr-home-circle {{searchOpen ? 'is-active' : ''}}" bindtap="toggleSearch" aria-label="搜索会话和项目"><view class="cr-symbol cr-symbol-search"></view></button></view>
    <scroll-view class="cr-home-filters" scroll-x="true" show-scrollbar="false"><view class="cr-home-filter-row"><button class="cr-home-filter {{libraryFilter === 'all' ? 'is-current' : ''}}" data-filter="all" bindtap="filterLibrary">全部</button><button class="cr-home-filter {{libraryFilter === 'chats' ? 'is-current' : ''}}" data-filter="chats" bindtap="filterLibrary">独立聊天</button><view wx:if="{{deviceLocked}}" class="cr-computer-pill"><view class="cr-computer-dot {{ready ? 'is-ready' : ''}}"></view><view class="cr-symbol cr-symbol-computer"></view><text>{{deviceName}}</text></view><picker wx:else range="{{devices}}" range-key="name" value="{{deviceIndex}}" bindchange="selectDevice" disabled="{{!devices.length}}"><view class="cr-computer-pill"><view class="cr-computer-dot {{ready ? 'is-ready' : ''}}"></view><view class="cr-symbol cr-symbol-computer"></view><text>{{deviceName}}</text><view class="cr-symbol cr-symbol-chevron"></view></view></picker></view></scroll-view>
    <view wx:if="{{searchOpen}}" class="cr-search cr-home-search"><view class="cr-symbol cr-symbol-search"></view><input value="{{search}}" placeholder="搜索会话和项目" maxlength="256" focus="{{searchOpen}}" adjust-position="false" bindkeyboardheightchange="keyboard" bindinput="search"/><button class="cr-icon" bindtap="toggleSearch" aria-label="关闭搜索">×</button></view>
    <view wx:if="{{!ready && authorized}}" class="cr-connection-hint"><text>{{stateTitle}} · {{stateHint}}</text><button wx:if="{{state === 'forbidden' || state === 'revoked' || state === 'reauthorize'}}" class="cr-text" data-page="settings" bindtap="navigate">检查授权</button><button wx:elif="{{deviceId}}" class="cr-text" bindtap="reconnect">重连</button></view>
    <view wx:if="{{wakeAvailable}}" class="cr-power"><text>{{powerText}}</text><button class="cr-text" data-page="power" bindtap="navigate">查看设备详情</button></view>
    <view wx:if="{{archived}}" class="cr-home-archive"><text>已归档</text><button class="cr-text" disabled="{{!ready || loading}}" bindtap="toggleArchived">返回最近</button></view>
  </view>

  <view wx:else class="cr-header">
    <button class="cr-icon cr-back" bindtap="{{view === 'chat' ? 'backLibrary' : 'back'}}" aria-label="返回">‹</button>
    <view class="cr-header-title"><text class="cr-title">{{view === 'chat' ? title : view === 'files' ? '项目文件' : view === 'settings' ? '设置' : view === 'automations' ? '自动化' : '技能与应用'}}</text><text class="cr-subtitle">{{view === 'chat' ? (project || '独立聊天') + ' · ' + deviceName : deviceName}}</text></view>
    <view wx:if="{{view === 'chat'}}" class="cr-header-actions"><button class="cr-icon" disabled="{{!ready || busy}}" bindtap="openNew" aria-label="新建聊天"><view class="cr-ui-icon cr-ui-compose"></view></button><button class="cr-icon" bindtap="openMenu" aria-label="聊天操作">···</button></view>
    <button wx:elif="{{view === 'catalog' || view === 'automations'}}" class="cr-icon" disabled="{{!ready || catalogLoading}}" bindtap="refreshCatalog" aria-label="刷新目录">↻</button>
  </view>
  <view wx:if="{{feedback}}" class="cr-feedback"><text>{{feedback}}</text><button class="cr-icon" bindtap="dismissFeedback" aria-label="关闭提示">×</button></view>

  <scroll-view wx:if="{{view === 'library'}}" class="cr-library-scroll" scroll-y="true">
    <view wx:if="{{!authorized}}" class="cr-empty"><text class="cr-empty-glyph">✦</text><text class="cr-empty-title">随时继续你的 Codex</text><text>连接开发电脑，在微信里继续项目和聊天。</text><view class="cr-onboarding-steps"><text>1. 电脑登录账号，连接原 Codex 窗口</text><text>2. 手机登录同一 Cloud 的同一账号</text><text>3. 自动显示你的电脑，选择后开始</text></view><button class="cr-primary" data-page="settings" bindtap="navigate">前往我的，登录账号</button><button class="cr-text" data-page="help" bindtap="navigate">查看使用指引</button></view>
    <view wx:elif="{{deviceUnavailable}}" class="cr-empty"><text class="cr-empty-glyph">✦</text><text class="cr-empty-title">无法访问这台设备</text><text>设备已被移除或不在当前授权范围内。请返回“我的设备”重新选择。</text><button class="cr-primary" data-page="devices" bindtap="navigate">返回我的设备</button></view>
    <view wx:elif="{{!devices.length}}" class="cr-empty"><text class="cr-empty-glyph">✦</text><text class="cr-empty-title">{{devicesLoaded ? '添加你的开发电脑' : deviceLoading ? '正在读取电脑' : '连接开发电脑'}}</text><text>{{devicesLoaded ? '手机已授权。在 Windows 版 CodexDock 连接同一个 Cloud，再连接原 Codex 窗口。' : '请检查手机与 Cloud 的连接，再读取已授权的开发电脑。'}}</text><button class="cr-primary" disabled="{{deviceLoading}}" bindtap="loadDevices">{{deviceLoading ? '正在读取…' : '刷新电脑列表'}}</button><button class="cr-text" data-page="settings" bindtap="navigate">我的授权与设置</button></view>
    <block wx:else>
      <template wx:if="{{recentFirst || recentTimeline}}" is="recentSection" data="{{recent,homeOrder,archived,recentCollapsed,ready,busy,search,loading,libraryFilter,recentTimeline,recentHasPrevious,recentHasNext}}"/>
      <view wx:if="{{pinned.length && !recentTimeline}}" class="cr-library-section"><view class="cr-section-head"><button class="cr-section-title" data-id="pinned" bindtap="toggleSection">置顶<view wx:if="{{sections.pinned === false}}" class="cr-symbol cr-symbol-chevron"></view></button></view><template wx:if="{{sections.pinned !== false}}" is="threadRows" data="{{rows:pinned}}"/></view>
      <view wx:if="{{!recentTimeline}}" class="cr-library-section"><view class="cr-section-head"><button class="cr-section-title" data-id="projects" bindtap="toggleSection">项目<view wx:if="{{sections.projects === false}}" class="cr-symbol cr-symbol-chevron"></view></button></view>
        <block wx:if="{{sections.projects !== false}}"><view wx:for="{{groups}}" wx:key="id" wx:for-item="group" class="cr-project-group">
          <view class="cr-project-header"><button class="cr-project-toggle" data-id="{{group.id}}" bindtap="toggleProject" bindlongpress="openProjectMenu" aria-label="展开或收起项目"><view class="cr-symbol cr-symbol-folder"></view><text class="cr-project-name">{{group.name}}</text><view wx:if="{{group.collapsed}}" class="cr-symbol cr-symbol-chevron"></view></button><button class="cr-icon cr-section-compose" disabled="{{!ready || busy}}" data-path="{{group.path}}" bindtap="createThread" aria-label="新建项目会话"><view class="cr-symbol cr-symbol-compose"></view></button></view>
          <block wx:if="{{!group.collapsed}}"><template is="threadRows" data="{{rows:group.threads}}"/><text wx:if="{{!group.count}}" class="cr-empty-small cr-project-empty">还没有会话，点击右侧开始</text><view wx:if="{{group.hasPrevious || group.hasNext}}" class="cr-pagination"><button class="cr-text" disabled="{{!group.hasPrevious}}" data-id="{{group.id}}" data-direction="-1" bindtap="groupPage">上一组</button><button class="cr-text" disabled="{{!group.hasNext}}" data-id="{{group.id}}" data-direction="1" bindtap="groupPage">下一组</button></view></block>
        </view><text wx:if="{{!groups.length}}" class="cr-empty-small">{{search ? '没有匹配的项目与聊天' : ready ? '暂无授权项目' : '连接电脑后读取项目'}}</text><view wx:if="{{libraryHasPrevious || libraryHasNext}}" class="cr-pagination"><button class="cr-text" disabled="{{!libraryHasPrevious}}" data-direction="-1" bindtap="libraryPage">上一组项目</button><button class="cr-text" disabled="{{!libraryHasNext}}" data-direction="1" bindtap="libraryPage">下一组项目</button></view></block>
      </view>
      <template wx:if="{{!recentFirst && !recentTimeline}}" is="recentSection" data="{{recent,homeOrder,archived,recentCollapsed,ready,busy,search,loading,libraryFilter,recentTimeline,recentHasPrevious,recentHasNext}}"/>
      <button wx:if="{{hasMore}}" class="cr-load-more" disabled="{{loading || !ready}}" bindtap="more">{{loading ? '正在读取…' : '读取更多聊天'}}</button><view class="cr-version">Codex Remote {{version}}</view>
    </block>
  </scroll-view>
  <view wx:if="{{view === 'library' && authorized && devices.length}}" class="cr-home-composer"><button class="cr-home-plus" disabled="{{!ready || busy}}" bindtap="openNew" aria-label="新建会话">＋</button><button class="cr-home-prompt" disabled="{{!ready || busy}}" bindtap="openNew">向 Codex 提问</button><button class="cr-home-compose" disabled="{{!ready || busy}}" bindtap="openNew" aria-label="选择项目开始会话"><view class="cr-symbol cr-symbol-compose"></view></button></view>

  <block wx:elif="{{view === 'chat'}}">
    <view wx:if="{{!ready || recovering || threadArchived}}" class="cr-chat-status"><button class="cr-text" bindtap="openStatus">{{threadArchived ? '已归档' : stateTitle}} ›</button><button wx:if="{{!ready}}" class="cr-text" bindtap="reconnect">重连</button></view>
    <view wx:if="{{historyProgress}}" class="cr-history-state"><text>{{historyProgress}}</text><button wx:if="{{readingHistory}}" class="cr-text" bindtap="cancelHistory">取消读取</button><button wx:elif="{{historyResume}}" class="cr-text" disabled="{{!ready}}" bindtap="resumeHistory">继续读取</button></view>
    <view wx:if="{{beginningIndex >= 0}}" class="cr-history-state"><text>正在阅读历史</text><button class="cr-text" disabled="{{!ready}}" bindtap="jump">返回最新</button></view>
    <scroll-view class="cr-chat-scroll" scroll-y="true" scroll-top="{{scrollTop}}" scroll-into-view="{{scrollTarget}}" scroll-with-animation="false" upper-threshold="140" lower-threshold="180" bindscroll="chatScroll" bindscrolltoupper="reachedTop" bindscrolltolower="reachedBottom" bindtouchstart="chatTouchStart" bindtouchmove="chatTouchMove" bindtouchend="chatTouchEnd" bindtouchcancel="chatTouchEnd">
      <view wx:if="{{loading && !messages.length}}" class="cr-empty-small">正在读取原窗口的聊天…</view>
      <view wx:if="{{!loading && !messages.length}}" class="cr-chat-welcome"><text class="cr-empty-glyph">✦</text><text class="cr-empty-title">从一个想法开始</text><text>在下面发送任务，与你电脑上的 Codex 继续同一段对话。</text></view>
      <view wx:for="{{messages}}" wx:key="key" wx:for-item="message" wx:if="{{message.kind !== 'work' || message.visible}}" id="{{message.domId}}" class="cr-message cr-message-{{message.kind}} {{message.kind === 'user' && message.images.length ? 'cr-user-images' : ''}}">
        <view wx:if="{{message.kind === 'work' && message.turnId === activeTurnId && running && elapsed && !approvals.length && !interrupting && beginningIndex < 0}}" class="cr-work-elapsed"><text>已处理 {{elapsed}}</text></view>
        <button wx:elif="{{message.kind === 'work' && message.foldable}}" class="cr-work-row" data-key="{{message.key}}" data-turn="{{message.turnId}}" aria-expanded="{{message.expanded}}" bindtap="toggleRow"><text>{{message.text}}</text><view class="cr-native-chevron {{message.expanded ? 'is-open' : ''}}"></view></button>
        <text wx:elif="{{message.kind === 'work'}}" class="cr-work-label">{{message.text}}</text>
        <button wx:elif="{{message.kind === 'activityGroup'}}" class="cr-activity-group" data-key="{{message.key}}" data-turn="{{message.turnId}}" aria-expanded="{{message.expanded}}" bindtap="toggleRow"><view class="cr-native-icon cr-native-{{message.icon}}"></view><text class="cr-row-label">{{message.label}}</text><text wx:if="{{message.notice}}" class="cr-activity-failed">{{message.notice}}</text><view class="cr-native-chevron {{message.expanded ? 'is-open' : ''}}"></view></button>
        <view wx:elif="{{message.kind === 'compaction'}}" class="cr-compaction"><view></view><text>▤ {{message.label}}</text><view></view></view>
        <view wx:elif="{{message.kind === 'large'}}" class="cr-large-content"><text>{{message.label}}</text><text class="cr-muted">{{message.text}}</text><button class="cr-text" disabled="{{!ready}}" bindtap="retryContent">继续读取完整内容</button></view>
        <view wx:elif="{{message.kind === 'imageActivity'}}" class="cr-image-activity">
          <button class="cr-image-toggle" data-key="{{message.key}}" aria-expanded="{{message.expanded}}" bindtap="toggleImageRow"><view class="cr-native-icon cr-native-images"></view><text>{{message.label}}</text><view class="cr-native-chevron {{message.expanded ? 'is-open' : ''}}"></view></button>
          <view wx:if="{{message.expanded}}" class="cr-message-images cr-image-previews"><button wx:for="{{message.images}}" wx:key="key" wx:for-item="image" wx:for-index="imageIndex" class="cr-image-button" data-key="{{message.key}}" data-index="{{imageIndex}}" bindtap="viewImage"><image wx:if="{{image.src}}" src="{{image.src}}" mode="aspectFit"/><text wx:else>▧ 点击读取图片</text></button></view>
        </view>
        <block wx:else>
          <view wx:if="{{message.kind === 'activity'}}" class="cr-activity-card"><button class="cr-activity-toggle" data-key="{{message.key}}" data-turn="{{message.turnId}}" aria-expanded="{{message.expanded}}" bindtap="toggleRow"><view class="cr-ui-icon cr-ui-{{message.icon}}"></view><text class="cr-row-label">{{message.label}}</text><text wx:if="{{message.failed}}" class="cr-activity-failed">!</text><text class="cr-row-chevron">{{message.expanded ? '⌄' : '›'}}</text></button><view wx:if="{{message.expanded}}" class="cr-activity-detail"><view class="cr-activity-heading"><text>{{message.status === 'inProgress' ? '运行中' : message.status === 'interrupted' ? '已停止' : '已完成'}}</text><text wx:if="{{message.exitCode !== undefined}}">退出码 {{message.exitCode}}</text></view><text wx:if="{{message.command}}" class="cr-code" selectable="true">{{message.command}}</text><text wx:if="{{message.text}}" class="cr-output" selectable="true">{{message.text}}</text><button class="cr-text" data-key="{{message.key}}" bindtap="openDetail">查看完整详情</button></view></view>
          <view wx:elif="{{message.kind === 'user'}}" class="cr-user-content"><view wx:if="{{message.images.length}}" class="cr-message-images cr-image-previews"><button wx:for="{{message.images}}" wx:key="key" wx:for-item="image" wx:for-index="imageIndex" class="cr-image-button" data-key="{{message.key}}" data-index="{{imageIndex}}" bindtap="viewImage"><image wx:if="{{image.src}}" src="{{image.src}}" mode="aspectFit"/><text wx:else>正在读取图片 · 点击重试</text></button></view><text wx:if="{{message.text}}" class="cr-message-text" selectable="true">{{message.text}}</text></view>
          <rich-text wx:elif="{{message.kind === 'assistant'}}" class="cr-markdown" nodes="{{message.nodes}}" user-select="true"/>
          <view wx:elif="{{message.kind === 'reasoning' || message.kind === 'plan'}}" class="cr-reasoning"><button class="cr-reasoning-toggle" data-key="{{message.key}}" data-turn="{{message.turnId}}" aria-expanded="{{message.expanded}}" bindtap="toggleRow"><text class="cr-row-label">{{message.label}}</text><view class="cr-native-chevron {{message.expanded ? 'is-open' : ''}}"></view></button><rich-text wx:if="{{message.expanded}}" class="cr-reasoning-detail" nodes="{{message.nodes}}" user-select="true"/></view>
          <text wx:else class="cr-message-text" selectable="true">{{message.text}}</text>
          <view wx:if="{{message.kind !== 'user' && message.images.length}}" class="cr-inline-images"><button class="cr-image-toggle" data-key="{{message.key}}" aria-expanded="{{message.imagesExpanded}}" bindtap="toggleImageRow"><view class="cr-ui-icon cr-ui-photo"></view><text>图片 {{message.images.length}} 张图片</text><text class="cr-image-chevron">{{message.imagesExpanded ? '⌄' : '›'}}</text></button><view wx:if="{{message.imagesExpanded}}" class="cr-message-images cr-image-previews"><button wx:for="{{message.images}}" wx:key="key" wx:for-item="image" wx:for-index="imageIndex" class="cr-image-button" data-key="{{message.key}}" data-index="{{imageIndex}}" bindtap="viewImage"><image wx:if="{{image.src}}" src="{{image.src}}" mode="aspectFit"/><text wx:else>▧ {{image.label}}</text></button></view></view>
          <view wx:if="{{message.skills.length}}" class="cr-message-tags"><text wx:for="{{message.skills}}" wx:key="path" class="cr-tag">✧ {{item.name}}</text></view>
          <button wx:if="{{message.kind !== 'activity' || message.expanded}}" wx:for="{{message.files}}" wx:key="path" class="cr-file-link" data-path="{{item.path}}" bindtap="openFiles">▤ {{item.label}}</button>
          <view wx:if="{{message.links.length}}" class="cr-message-tags"><button wx:for="{{message.links}}" wx:key="target" class="cr-text cr-link" data-target="{{item.target}}" bindtap="openLink">↗ {{item.label}}</button></view>
          <button wx:if="{{message.hasMoreText && message.kind !== 'activity'}}" class="cr-text" data-key="{{message.key}}" bindtap="openDetail">查看完整内容</button>
          <view wx:if="{{message.showActions}}" class="cr-message-actions"><button class="cr-text" data-key="{{message.key}}" bindtap="copyRow">复制</button><button wx:if="{{canControl && !running && beginningIndex < 0}}" class="cr-text" data-action="fork" data-turn="{{message.turnId}}" bindtap="threadAction">分支</button><button wx:if="{{message.kind === 'user' && canControl && !running && beginningIndex < 0}}" class="cr-text" data-action="rollback" data-turn="{{message.turnId}}" bindtap="threadAction">回退</button></view>
        </block>
      </view>
      <view wx:if="{{(running || plan.length) && !approvals.length && beginningIndex < 0}}" class="cr-live-work"><button wx:if="{{plan.length}}" class="cr-live" aria-expanded="{{progressOpen}}" bindtap="toggleProgress"><text>{{running ? taskState : '任务计划'}}</text><view class="cr-native-chevron {{progressOpen ? 'is-open' : ''}}"></view></button><text wx:else class="cr-live-label">{{taskState}}</text><view wx:if="{{progressOpen && plan.length}}" class="cr-plan"><text wx:if="{{running}}" class="cr-feature-note">{{elapsed ? '已运行 ' + elapsed : '任务正在电脑上运行'}}</text><view wx:for="{{plan}}" wx:key="step"><text>{{item.status === 'completed' ? '✓' : item.status === 'inProgress' ? '◉' : '○'}} {{item.step}}</text></view><button class="cr-text" bindtap="openStatus">查看连接与用量</button></view></view>
      <view class="cr-scroll-inset" style="height:{{composerInset}}px;"></view><view id="chat-end" class="cr-chat-end"></view>
    </scroll-view>
    <view wx:if="{{readingHistory}}" class="cr-chat-loading" role="status">正在加载会话内容…</view>
    <button wx:if="{{showJump || hasWindowAfter}}" class="cr-jump" aria-label="返回最新消息" bindtap="jump">↓</button>
    <view class="cr-composer-area">
      <button wx:if="{{changes.count}}" class="cr-changes-pill" bindtap="openChanges"><text>{{changes.count}} 个文件</text><text class="cr-added">+{{changes.added}}</text><text class="cr-removed">−{{changes.removed}}</text><text>›</text></button>
      <view wx:if="{{queue.length}}" class="cr-queue"><view class="cr-queue-title"><text>{{queue.length}} 条排队消息</text><text class="cr-muted">沿用当前任务参数</text></view><scroll-view class="cr-queue-scroll" scroll-y="true"><view wx:for="{{queue}}" wx:key="id" class="cr-queue-row"><text class="cr-queue-text">{{item.position}}. {{item.text || '附件消息'}}{{item.images ? ' · ' + item.images + ' 张图片' : ''}}{{item.skills ? ' · ' + item.skills : ''}}</text><view class="cr-queue-actions"><button class="cr-text" disabled="{{!canControl || busy}}" data-id="{{item.id}}" bindtap="editQueue">编辑</button><button class="cr-text" disabled="{{!canControl || busy}}" data-action="delete" data-id="{{item.id}}" bindtap="queueAction">删除</button><button class="cr-text" disabled="{{!canControl || busy}}" data-action="start" data-id="{{item.id}}" bindtap="queueAction">立即处理</button><button class="cr-icon" disabled="{{!canControl || busy || index === 0}}" data-action="reorder" data-id="{{item.id}}" data-direction="-1" bindtap="queueAction" aria-label="上移">↑</button><button class="cr-icon" disabled="{{!canControl || busy || index === queue.length - 1}}" data-action="reorder" data-id="{{item.id}}" data-direction="1" bindtap="queueAction" aria-label="下移">↓</button></view></view></scroll-view></view>
      <view wx:if="{{receiptLabel}}" class="cr-receipt cr-receipt-{{receiptState}}"><text>{{receiptLabel}}</text><view wx:if="{{receiptState === 'uncertain'}}"><button class="cr-text" disabled="{{!ready || queryingReceipt}}" bindtap="queryReceipt">查询回执</button><button class="cr-text" disabled="{{!ready}}" bindtap="restoreUnaccepted">确认未执行后恢复</button></view></view>
      <view wx:if="{{approvals.length}}" class="cr-approval-banner"><text>需要你的回复</text><button wx:for="{{approvals}}" wx:key="key" class="cr-primary" data-key="{{item.key}}" bindtap="openApproval">{{item.title}} ›</button></view>
      <view wx:if="{{!approvals.length}}" class="cr-composer {{!keyboardHeight && !inputFocused && !prompt && !draftImages.length && !draftSkills.length && !draftFiles.length && !editingQueue ? 'cr-composer-compact' : ''}}"><view wx:if="{{editingQueue}}" class="cr-editing"><text>正在编辑排队消息</text><button class="cr-text" disabled="{{busy}}" bindtap="cancelQueueEdit">取消编辑</button></view>
        <view wx:if="{{draftImages.length || draftSkills.length || draftFiles.length}}" class="cr-attachments"><view wx:for="{{draftImages}}" wx:key="index" class="cr-image-chip"><image wx:if="{{item.src}}" src="{{item.src}}" mode="aspectFill" data-index="{{item.index}}" bindtap="previewDraftImage"/><text wx:else>▧ 图片</text><button class="cr-chip-close" data-kind="images" data-index="{{item.index}}" bindtap="removeAttachment">×</button></view><view wx:for="{{draftSkills}}" wx:key="index" class="cr-tag">✧ {{item.name}}<button class="cr-chip-close" data-kind="skills" data-index="{{item.index}}" bindtap="removeAttachment">×</button></view><view wx:for="{{draftFiles}}" wx:key="index" class="cr-tag">▤ {{item.label}}<button class="cr-chip-close" data-kind="files" data-index="{{item.index}}" bindtap="removeAttachment">×</button></view></view>
        <textarea class="cr-textarea" value="{{prompt}}" placeholder="{{!canControl ? ready ? '正在恢复会话或仅可查看' : '连接恢复后继续输入' : running ? '跟进' : '向 Codex 提问'}}" maxlength="-1" auto-height="true" adjust-position="false" hold-keyboard="true" confirm-type="{{sendWithEnter ? 'send' : 'return'}}" disabled="{{busy || changingPermissions || receiptState === 'sending' || receiptState === 'uncertain'}}" bindfocus="inputFocus" bindblur="inputBlur" bindinput="input" bindconfirm="confirmSend" bindkeyboardheightchange="keyboard"/>
        <view class="cr-composer-toolbar"><view class="cr-composer-tools"><button class="cr-icon" disabled="{{!canControl || busy || uploadingAttachment || receiptState === 'uncertain'}}" bindtap="openAttachments" aria-label="添加附件">＋</button><button class="cr-icon cr-permission-button {{selectedPermission === 'full-access' ? 'is-full-access' : ''}}" bindtap="openPermissions" aria-label="{{permissionLabel}}"><view class="cr-ui-icon cr-ui-{{selectedPermission === 'full-access' ? 'warning' : selectedPermission === 'custom' ? 'settings' : 'shield'}}"></view></button></view><view class="cr-composer-send"><button class="cr-icon cr-context-button" bindtap="openOptions" aria-label="选择模型与模型强度"><view class="cr-context-ring"></view></button><button wx:if="{{running}}" class="cr-stop {{canSend ? 'cr-stop-secondary' : ''}}" disabled="{{!canInterrupt}}" bindtap="interrupt" aria-label="停止任务"><view class="cr-stop-square"></view></button><button wx:if="{{!running || canSend}}" class="cr-send" disabled="{{!canSend}}" aria-label="{{sendLabel}}" bindtap="send">↑</button></view></view>
        <view wx:if="{{running && queueSupported && !editingQueue}}" class="cr-send-modes"><button class="cr-text {{sendMode === 'queue' ? 'is-active' : ''}}" data-mode="queue" bindtap="chooseSendMode">排队</button><button class="cr-text {{sendMode === 'steer' ? 'is-active' : ''}}" data-mode="steer" bindtap="chooseSendMode">引导当前任务</button></view>
      </view><text wx:if="{{settingsHint}}" class="cr-setting-note">{{settingsHint}}</text>
    </view>
  </block>

  <block wx:elif="{{view === 'catalog' || view === 'automations'}}">
    <view wx:if="{{view === 'catalog'}}" class="cr-catalog-tabs"><button class="cr-text {{catalogKind === 'skill' ? 'is-active' : ''}}" data-kind="skill" bindtap="chooseCatalog">技能</button><button class="cr-text {{catalogKind === 'plugin' ? 'is-active' : ''}}" data-kind="plugin" bindtap="chooseCatalog">插件</button><button class="cr-text {{catalogKind === 'app' ? 'is-active' : ''}}" data-kind="app" bindtap="chooseCatalog">应用</button><button class="cr-text {{catalogKind === 'mcp' ? 'is-active' : ''}}" data-kind="mcp" bindtap="chooseCatalog">MCP</button></view>
    <view class="cr-catalog-toolbar"><input class="cr-search-input" value="{{catalogQuery}}" placeholder="搜索能力目录" bindinput="catalogSearch"/><picker wx:if="{{catalogKind === 'skill' || catalogKind === 'plugin'}}" range="{{projects}}" range-key="name" value="{{catalogCwdIndex}}" bindchange="chooseCatalogCwd"><view class="cr-project-pill">▱ {{projects[catalogCwdIndex].name || '选择项目'}} ⌄</view></picker></view>
    <text wx:if="{{catalogError}}" class="cr-panel-error">{{catalogError}}</text><scroll-view class="cr-feature-scroll" scroll-y="true"><text wx:if="{{!ready}}" class="cr-empty-small">连接开发电脑后读取</text><text wx:elif="{{catalogLoading && !catalogRows.length}}" class="cr-empty-small">正在读取原窗口目录…</text><text wx:elif="{{!catalogRows.length}}" class="cr-empty-small">暂无匹配内容，可在原窗口添加后刷新。</text><view wx:for="{{catalogRows}}" wx:key="key" class="cr-catalog-card"><view class="cr-card-heading"><text class="cr-card-icon">{{view === 'automations' ? '◷' : '✧'}}</text><text class="cr-badge cr-capability-{{item.status}}">{{item.badge}}</text></view><text class="cr-card-title">{{item.name}}</text><text class="cr-card-description">{{view === 'automations' ? item.projects : item.description}}</text><text wx:if="{{item.reason}}" class="cr-native-reason">{{item.reason}}</text><text wx:if="{{item.schedule}}" class="cr-muted cr-code">{{item.schedule}}</text><view class="cr-card-actions"><button class="cr-outline" data-index="{{item.index}}" bindtap="catalogDetail">详情</button><button wx:if="{{catalogKind === 'skill'}}" class="cr-primary" disabled="{{!item.enabled || !canControl}}" data-index="{{item.index}}" bindtap="useSkill">添加到聊天</button></view></view><view wx:if="{{view === 'catalog'}}" class="cr-pagination"><button class="cr-text" disabled="{{!ready || catalogLoading || !catalogHasPrevious}}" bindtap="catalogPrevious">上一页</button><text>第 {{catalogPage}} 页</text><button class="cr-text" disabled="{{!ready || catalogLoading || !catalogHasMore}}" bindtap="catalogMore">下一页</button></view><text wx:if="{{view === 'catalog'}}" class="cr-feature-note">每页 24 项，搜索仅针对当前页。</text><view class="cr-feature-note">{{view === 'automations' ? '创建、编辑与调度请在原 Codex 窗口管理。' : catalogKind !== 'skill' ? '安装、授权与连接设置请在原 Codex 窗口管理。' : '技能来自所选项目，添加后随下一条消息发送。'}}</view><button wx:if="{{catalogKind === 'mcp'}}" class="cr-outline" disabled="{{!ready || catalogLoading}}" bindtap="reloadMcp">重新加载 MCP 服务</button></scroll-view>
  </block>

  <view wx:elif="{{view === 'files'}}" class="cr-file-browser"><template is="projectFiles" data="{{fileState,fileProject,fileHasPrevious,fileHasNext,projects,canControl}}"/></view>

  <scroll-view wx:elif="{{view === 'settings'}}" class="cr-feature-scroll" scroll-y="true"><view class="cr-settings-section"><text class="cr-card-title">额度与上下文</text><button class="cr-outline" disabled="{{!ready || quotaLoading}}" bindtap="refreshQuota">{{quotaLoading ? '正在读取额度…' : '刷新原生额度'}}</button><text wx:if="{{quotaReason}}" class="cr-native-reason">{{quotaReason}}</text><view wx:for="{{quotaRows}}" wx:key="id" class="cr-quota-card"><text class="cr-card-title">{{item.name}}</text><text class="cr-quota-metrics">{{item.metrics}}</text><text wx:if="{{item.credits}}" class="cr-native-reason">{{item.credits}}</text></view><text class="cr-card-title">上下文</text><text>{{contextText}}</text><text wx:if="{{contextReason}}" class="cr-native-reason">{{contextReason}}</text></view><view class="cr-settings-section"><text class="cr-card-title">外观</text><view class="cr-setting-options"><button class="cr-outline {{themeMode === 'system' ? 'is-active' : ''}}" data-value="system" bindtap="changeTheme">跟随系统</button><button class="cr-outline {{themeMode === 'light' ? 'is-active' : ''}}" data-value="light" bindtap="changeTheme">浅色</button><button class="cr-outline {{themeMode === 'dark' ? 'is-active' : ''}}" data-value="dark" bindtap="changeTheme">深色</button></view></view><view class="cr-settings-section"><text class="cr-card-title">输入</text><view class="cr-setting-row"><text>键盘完成键发送消息</text><switch checked="{{sendWithEnter}}" bindchange="setEnter"/></view><text class="cr-feature-note">运行中的消息默认操作</text><view class="cr-setting-options"><button class="cr-outline {{sendMode === 'queue' ? 'is-active' : ''}}" data-mode="queue" bindtap="chooseSendMode">加入队列</button><button class="cr-outline {{sendMode === 'steer' ? 'is-active' : ''}}" data-mode="steer" bindtap="chooseSendMode">引导当前任务</button></view></view><view class="cr-settings-section"><text class="cr-card-title">项目与聊天</text><view class="cr-setting-options"><button class="cr-outline {{sort === 'updated' ? 'is-active' : ''}}" disabled="{{!ready}}" data-sort="updated" bindtap="librarySort">最近更新</button><button class="cr-outline {{sort === 'created' ? 'is-active' : ''}}" disabled="{{!ready}}" data-sort="created" bindtap="librarySort">最近创建</button></view><view class="cr-setting-options"><button class="cr-outline {{homeOrder === 'project' ? 'is-active' : ''}}" data-order="project" bindtap="chooseHomeOrder">按项目</button><button class="cr-outline {{homeOrder === 'updated' ? 'is-active' : ''}}" data-order="updated" bindtap="chooseHomeOrder">按时间</button><button class="cr-outline {{homeOrder === 'priority' ? 'is-active' : ''}}" data-order="priority" bindtap="chooseHomeOrder">优先级</button></view><view class="cr-setting-row"><text>首页优先显示最近</text><switch checked="{{recentFirst}}" bindchange="setRecentFirst"/></view><text wx:if="{{hiddenProjects.length}}" class="cr-feature-note">已收纳项目</text><view wx:for="{{hiddenProjects}}" wx:key="id" class="cr-setting-row"><text>{{item.name}}</text><button class="cr-text" disabled="{{!ready}}" data-id="{{item.id}}" bindtap="unhideProject">恢复显示</button></view></view><view class="cr-feature-note">项目整理与电脑端同步，首页显示方式会记住当前电脑的选择。未发送输入仅在本次小程序会话中保留。</view><view class="cr-version">Codex Remote {{version}}</view></scroll-view>


  <view wx:if="{{homeMenu && view === 'library'}}" class="cr-home-menu-overlay" bindtap="closeHomeMenu"><view class="cr-home-menu" catchtap="noop">
    <button class="cr-home-menu-row" data-order="priority" bindtap="chooseHomeOrder"><text class="cr-menu-check">{{homeOrder === 'priority' ? '✓' : ''}}</text><view class="cr-symbol cr-symbol-bell"></view><text>优先级</text></button>
    <button class="cr-home-menu-row" data-order="project" bindtap="chooseHomeOrder"><text class="cr-menu-check">{{homeOrder === 'project' ? '✓' : ''}}</text><view class="cr-symbol cr-symbol-folder"></view><text>按项目</text></button>
    <button class="cr-home-menu-row" data-order="updated" bindtap="chooseHomeOrder"><text class="cr-menu-check">{{homeOrder === 'updated' ? '✓' : ''}}</text><view class="cr-symbol cr-symbol-clock"></view><text>按时间倒序排列</text></button>
    <view class="cr-home-menu-divider"></view>
    <button class="cr-home-menu-row" bindtap="toggleRecentFirst"><text class="cr-menu-check">{{recentFirst ? '✓' : ''}}</text><view class="cr-symbol cr-symbol-chat"></view><text>优先显示“最近”</text></button>
    <view class="cr-home-menu-divider"></view><text class="cr-home-menu-label">管理</text>
    <button class="cr-home-menu-row" disabled="{{!ready || loading}}" bindtap="toggleArchived"><text class="cr-menu-check"></text><view class="cr-symbol cr-symbol-archive"></view><text>{{archived ? '返回最近会话' : '已归档会话'}}</text></button>
    <button class="cr-home-menu-row" data-page="power" bindtap="navigate"><text class="cr-menu-check"></text><view class="cr-symbol cr-symbol-computer"></view><text>设备详情</text></button>
    <button class="cr-home-menu-row" data-kind="settings" bindtap="openFeature"><text class="cr-menu-check"></text><view class="cr-symbol cr-symbol-settings"></view><text>设置</text></button>
    <button class="cr-home-menu-row" data-kind="skills" bindtap="openFeature"><text class="cr-menu-check"></text><view class="cr-symbol cr-symbol-apps"></view><text>技能与应用</text></button>
    <button class="cr-home-menu-row" data-kind="automations" bindtap="openFeature"><text class="cr-menu-check"></text><view class="cr-symbol cr-symbol-automation"></view><text>自动化</text></button>
    <view class="cr-home-menu-divider"></view><view class="cr-home-quota-heading"><text class="cr-home-menu-label">剩余用量</text><button class="cr-text" disabled="{{!ready || quotaLoading}}" bindtap="refreshQuota">刷新</button></view>
    <view class="cr-home-quota"><text wx:for="{{quotaSummary}}" wx:key="id">{{item.label}} <text class="cr-quota-percent">{{item.remaining}}%</text></text><text wx:if="{{!quotaSummary.length}}" class="cr-home-quota-empty">{{quotaLoading ? '正在读取…' : !ready ? '连接电脑后查看' : '暂时无法读取用量'}}</text></view>
  </view></view>

  <view wx:if="{{sheet}}" class="cr-overlay cr-overlay-{{sheet}}" bindtap="closeSheet"><view class="cr-sheet cr-sheet-{{sheet}}" catchtap="noop"><view class="cr-sheet-handle"></view><view class="cr-sheet-heading"><button wx:if="{{sheet === 'models' || sheet === 'effort'}}" class="cr-icon" bindtap="optionBack" aria-label="返回高级设置">‹</button><text>{{sheet === 'new' ? '新建聊天' : sheet === 'options' ? '高级' : sheet === 'models' ? '模型' : sheet === 'effort' ? selectedModelName + ' ' + selectedEffortName : sheet === 'permissions' ? '应如何批准 Codex 操作？' : sheet === 'status' ? '工作状态' : sheet === 'changes' ? '更改' : sheet === 'files' ? '选择文件' : sheet === 'approval' ? approval.title : sheet === 'project' ? projectMenu.name : sheet === 'rename' ? renameTitle : sheet === 'detail' ? detailTitle : sheet === 'attachments' ? '添加到消息' : title}}</text><button class="cr-icon" bindtap="closeSheet" aria-label="关闭">×</button></view>
    <block wx:if="{{sheet === 'new'}}"><input class="cr-sheet-input" value="{{newProjectQuery}}" placeholder="搜索已授权项目" bindinput="newProjectSearch"/><scroll-view class="cr-sheet-scroll" scroll-y="true"><button wx:if="{{chatSupported}}" class="cr-sheet-row" disabled="{{busy}}" bindtap="newChat"><text>＋ 新建独立聊天</text><text class="cr-muted">无需选择项目</text></button><button wx:for="{{newProjects}}" wx:key="path" class="cr-sheet-row" disabled="{{busy}}" data-path="{{item.path}}" bindtap="createThread"><text>▱ {{item.name}}</text><text class="cr-muted">{{item.path}}</text></button><text wx:if="{{!newProjects.length}}" class="cr-empty-small">没有匹配的授权项目</text></scroll-view></block>
    <block wx:elif="{{sheet === 'options'}}"><view class="cr-advanced-group"><button class="cr-advanced-row" disabled="{{!ready || !models.length}}" data-kind="models" bindtap="openOptionList"><text>模型</text><view><text>{{selectedModelName}}</text><text class="cr-option-chevron">⌃<text>⌄</text></text></view></button><button class="cr-advanced-row" disabled="{{!ready || !efforts.length}}" data-kind="effort" bindtap="openOptionList"><text>模型强度</text><view><text>{{selectedEffortName}}</text><text class="cr-option-chevron">⌃<text>⌄</text></text></view></button></view><template is="effortSelector" data="{{ready,effortMax,sliderEffortIndex,effortChoices,selectedEffort}}"/><text class="cr-feature-note">选择用于下一次新任务。排队和引导沿用当前任务参数。</text><view class="cr-advanced-footer"><button class="cr-text" bindtap="inheritSettings">恢复原窗口参数</button><text>{{selectedMode === 'plan' ? '方案模式已开启' : '默认工作模式'}}</text></view><button class="cr-advanced-status cr-text" bindtap="openStatus">查看工作状态与上下文 ›</button></block>
    <scroll-view wx:elif="{{sheet === 'models'}}" class="cr-sheet-scroll cr-model-list" scroll-y="true"><text wx:if="{{!models.length}}" class="cr-empty-small">连接电脑后读取可用模型</text><button wx:for="{{models}}" wx:key="value" class="cr-model-option" disabled="{{!ready}}" data-value="{{item.value}}" bindtap="chooseModel"><view><text>{{item.name}}</text><text wx:if="{{item.description}}" class="cr-muted">{{item.description}}</text></view><text class="cr-menu-check">{{selectedModel === item.value ? '✓' : ''}}</text></button></scroll-view>
    <block wx:elif="{{sheet === 'effort'}}"><template is="effortSelector" data="{{ready,effortMax,sliderEffortIndex,effortChoices,selectedEffort}}"/></block>
    <block wx:elif="{{sheet === 'permissions'}}"><button class="cr-text cr-permission-help" bindtap="permissionHelp">了解更多</button><scroll-view class="cr-permission-scroll" scroll-y="true"><button wx:for="{{permissionChoices}}" wx:key="value" class="cr-permission-row" disabled="{{changingPermissions || (item.value !== 'custom' && (!permissionsSupported || !canControl))}}" data-value="{{item.value}}" bindtap="choosePermission"><view class="cr-ui-icon cr-ui-{{item.icon}}"></view><view class="cr-permission-copy"><text>{{item.name}}</text><text>{{item.description}}</text></view><text class="cr-permission-check">{{selectedPermission === item.value ? '✓' : ''}}</text></button></scroll-view><text class="cr-feature-note">{{changingPermissions ? '正在等待电脑确认…' : !ready ? '连接恢复后读取实际权限' : !permissionsSupported ? '当前电脑版本不支持权限切换，请更新后重连。' : permissionLabel + ' · 更改用于后续任务'}}</text></block>
    <block wx:elif="{{sheet === 'files'}}"><template is="projectFiles" data="{{fileState,fileProject,fileHasPrevious,fileHasNext,projects,canControl}}"/></block>
    <block wx:elif="{{sheet === 'changes'}}"><view class="cr-changes-summary"><text>{{changes.count}} 个文件</text><text class="cr-added">+{{changes.added}}</text><text class="cr-removed">−{{changes.removed}}</text></view><scroll-view class="cr-sheet-scroll" scroll-y="true"><button wx:for="{{changes.files}}" wx:key="path" class="cr-change-file" data-index="{{item.index}}" bindtap="showChange"><view class="cr-ui-icon cr-ui-file"></view><view class="cr-change-file-name"><text>{{item.path}}</text><text wx:if="{{item.kind}}" class="cr-muted">{{item.kind}}</text></view><text class="cr-added">+{{item.added}}</text><text class="cr-removed">−{{item.removed}}</text><text>›</text></button><text wx:if="{{!changes.count}}" class="cr-empty-small">此会话还没有文件更改</text></scroll-view><view wx:if="{{changesPages > 1}}" class="cr-pagination"><button class="cr-text" disabled="{{changesPage <= 1}}" data-direction="-1" bindtap="changesPage">上一页</button><text>{{changesPage}} / {{changesPages}}</text><button class="cr-text" disabled="{{changesPage >= changesPages}}" data-direction="1" bindtap="changesPage">下一页</button></view></block>
    <scroll-view wx:elif="{{sheet === 'status'}}" class="cr-sheet-scroll" scroll-y="true"><view class="cr-status-section"><text class="cr-card-title">{{taskState}}</text><text wx:if="{{elapsed}}" class="cr-feature-note">已运行 {{elapsed}}</text><text class="cr-feature-note">{{stateTitle}} · {{controlHint || deviceName}}</text><text class="cr-feature-note">{{syncLabel}}</text><button class="cr-text" data-action="refresh" bindtap="threadAction">刷新聊天</button></view><view class="cr-status-section"><text class="cr-card-title">上下文</text><text class="cr-feature-note">{{contextText || contextReason}}</text></view><view class="cr-status-section"><view class="cr-setting-row"><text class="cr-card-title">剩余用量</text><button class="cr-text" disabled="{{!ready || quotaLoading}}" bindtap="refreshQuota">刷新</button></view><view wx:for="{{quotaRows}}" wx:key="id" class="cr-quota-card"><text>{{item.name}}</text><text class="cr-quota-metrics">{{item.metrics}}</text><text wx:if="{{item.credits}}" class="cr-muted">{{item.credits}}</text></view><text wx:if="{{!quotaRows.length}}" class="cr-feature-note">{{quotaLoading ? '正在读取…' : quotaReason}}</text></view></scroll-view>
    <scroll-view wx:elif="{{sheet === 'menu'}}" class="cr-thread-menu-scroll" scroll-y="true"><button class="cr-chat-menu-row" data-action="pin" disabled="{{!ready}}" bindtap="threadAction"><view class="cr-ui-icon cr-ui-pin"></view><text>{{threadMenuPinned ? '取消置顶' : '置顶'}}</text></button><button class="cr-chat-menu-row" data-action="rename" disabled="{{!canControl}}" bindtap="threadAction"><view class="cr-ui-icon cr-ui-compose"></view><text>重命名</text></button><button class="cr-chat-menu-row" bindtap="copyThreadId"><view class="cr-ui-icon cr-ui-copy"></view><text>复制对话串 ID</text></button><button class="cr-chat-menu-row cr-menu-danger" data-action="{{threadArchived ? 'unarchive' : 'archive'}}" disabled="{{!ready || running}}" bindtap="threadAction"><view class="cr-ui-icon cr-ui-archive"></view><text>{{threadArchived ? '恢复聊天' : '归档'}}</text></button><view class="cr-chat-menu-divider"></view><button class="cr-chat-menu-row" bindtap="openChanges"><view class="cr-ui-icon cr-ui-branch"></view><text>更改</text></button><button class="cr-chat-menu-row" disabled="{{!ready || !cwd}}" bindtap="openFileSheet"><view class="cr-ui-icon cr-ui-folder"></view><text>文件</text></button><view class="cr-chat-menu-divider"></view><button class="cr-chat-menu-row" data-action="fork" disabled="{{!canControl || running}}" bindtap="threadAction"><view class="cr-ui-icon cr-ui-branch"></view><text>分支聊天</text></button><button class="cr-chat-menu-row" data-action="refresh" bindtap="threadAction"><view class="cr-ui-icon cr-ui-refresh"></view><text>刷新聊天</text></button><button class="cr-chat-menu-row" data-action="beginning" disabled="{{!ready || readingHistory}}" bindtap="threadAction"><view class="cr-ui-icon cr-ui-book"></view><text>跳至对话开头</text></button><button wx:if="{{canRelease}}" class="cr-chat-menu-row" data-action="release" bindtap="threadAction">交还桌面</button></scroll-view>
    <block wx:elif="{{sheet === 'project'}}"><text class="cr-feature-note">{{projectMenu.path}}</text><button class="cr-sheet-row" data-action="new" bindtap="projectAction">新建项目聊天</button><button class="cr-sheet-row" data-action="files" bindtap="projectAction">浏览项目文件</button><button class="cr-sheet-row" data-action="rename" bindtap="projectAction">修改显示名</button><view class="cr-setting-options"><button class="cr-outline" data-action="up" bindtap="projectAction">上移项目</button><button class="cr-outline" data-action="down" bindtap="projectAction">下移项目</button></view><button class="cr-sheet-row" data-action="hidden" bindtap="projectAction">收纳项目</button></block>
    <block wx:elif="{{sheet === 'rename'}}"><input class="cr-sheet-input" value="{{renameDraft}}" focus="true" maxlength="-1" placeholder="输入名称" adjust-position="false" bindkeyboardheightchange="keyboard" bindinput="renameInput"/><button class="cr-primary" disabled="{{busy || !renameDraft}}" bindtap="saveRename">保存</button></block>
    <scroll-view wx:elif="{{sheet === 'attachments'}}" class="cr-attachment-menu-scroll" scroll-y="true"><button class="cr-attachment-menu-row" data-source="camera" bindtap="addImages"><view class="cr-attachment-icon"><view class="cr-ui-icon cr-ui-camera"></view></view><text>相机</text></button><button class="cr-attachment-menu-row" data-source="album" bindtap="addImages"><view class="cr-attachment-icon"><view class="cr-ui-icon cr-ui-photo"></view></view><text>照片</text></button><button class="cr-attachment-menu-row" bindtap="addFiles"><view class="cr-attachment-icon"><view class="cr-ui-icon cr-ui-clip"></view></view><text>文件</text></button><button class="cr-attachment-menu-row" disabled="{{!cwd || !ready}}" bindtap="openFileSheet"><view class="cr-attachment-icon"><view class="cr-ui-icon cr-ui-folder"></view></view><text>电脑上的文件</text></button><view class="cr-chat-menu-divider"></view><button class="cr-attachment-menu-row" disabled="{{!planSupported || running}}" bindtap="togglePlanMode"><view class="cr-attachment-icon"><view class="cr-ui-icon cr-ui-plan"></view></view><text>方案模式</text><text class="cr-menu-check">{{selectedMode === 'plan' ? '✓' : ''}}</text></button><view class="cr-attachment-unavailable"><view class="cr-attachment-icon"><view class="cr-ui-icon cr-ui-goal"></view></view><view><text>追求目标</text><text class="cr-muted">请在电脑上设置</text></view></view><text class="cr-attachment-section">插件</text><button class="cr-attachment-menu-row" data-kind="plugins" bindtap="openFeature"><view class="cr-attachment-icon"><view class="cr-ui-icon cr-ui-tool"></view></view><text>技能与插件</text><text>›</text></button></scroll-view>
    <block wx:elif="{{sheet === 'detail'}}"><scroll-view class="cr-sheet-scroll cr-detail-scroll" scroll-y="true"><text class="cr-detail-text {{detailKind === 'activity' || detailKind === 'code' ? 'cr-code' : ''}}" selectable="true">{{detailText}}</text></scroll-view><view class="cr-pagination"><button class="cr-text" disabled="{{detailPage <= 1}}" data-direction="-1" bindtap="detailPage">上一页</button><text>{{detailPage}} / {{detailPages}}</text><button class="cr-text" disabled="{{detailPage >= detailPages}}" data-direction="1" bindtap="detailPage">下一页</button></view><button class="cr-primary" bindtap="copyDetail">复制完整内容</button></block>
    <block wx:elif="{{sheet === 'approval'}}"><scroll-view class="cr-sheet-scroll" scroll-y="true"><text class="cr-feature-note">{{approval.network ? '仅授权当前任务访问网络' : approval.elicitation ? '工具授权请在电脑处理，可在此拒绝或取消请求。' : '此决定只用于当前请求'}}</text><text wx:if="{{approval.cwd}}" class="cr-muted cr-approval-cwd">{{approval.cwd}}</text><text wx:if="{{approval.detail}}" class="cr-approval-detail cr-code" selectable="true">{{approval.detail}}</text><view wx:if="{{approval.files.length}}" class="cr-approval-files"><text class="cr-option-label">本次涉及的文件</text><text wx:for="{{approval.files}}" wx:key="path" class="cr-code cr-feature-note" selectable="true">{{item.kind}} · {{item.path}}</text></view><view wx:for="{{approval.questions}}" wx:key="id" wx:for-item="question" class="cr-question"><text class="cr-card-title">{{question.header}}</text><text>{{question.question}}</text><button wx:for="{{question.options}}" wx:key="label" wx:for-item="option" wx:for-index="optionIndex" class="cr-answer-option {{option.selected ? 'is-selected' : ''}}" disabled="{{responding}}" data-id="{{question.id}}" data-index="{{optionIndex}}" bindtap="answerOption"><text>{{option.selected ? '●' : '○'}} {{option.label}}</text><text wx:if="{{option.description}}" class="cr-muted">{{option.description}}</text></button><input wx:if="{{question.isSecret}}" class="cr-sheet-input" password="true" disabled="{{responding}}" adjust-position="false" value="{{question.value}}" maxlength="4000" placeholder="填写答案" data-id="{{question.id}}" bindkeyboardheightchange="keyboard" bindinput="answer"/><textarea wx:else class="cr-answer-input" value="{{question.value}}" maxlength="4000" adjust-position="false" placeholder="填写答案或补充说明" disabled="{{responding}}" data-id="{{question.id}}" bindkeyboardheightchange="keyboard" bindinput="answer"/></view><button wx:if="{{approval.url}}" class="cr-text" data-target="{{approval.url}}" bindtap="openLink">复制工具授权链接</button></scroll-view><view class="cr-approval-actions"><button wx:if="{{!approval.questions.length}}" class="cr-outline" disabled="{{!canControl || responding}}" data-allow="no" bindtap="decide">拒绝</button><button class="cr-primary" disabled="{{!canControl || responding || !approval.permissionSupported}}" data-allow="yes" bindtap="decide">{{responding ? '正在确认…' : approval.questions.length ? '提交回复' : approval.elicitation ? '取消请求' : '仅本次允许'}}</button></view></block>
  </view></view>
</view>
