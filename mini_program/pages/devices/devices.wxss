@import "../../styles/device.wxss";

.device-card { display:flex;align-items:center;gap:24rpx;padding:30rpx 28rpx;margin:0 0 20rpx;background:var(--surface);border:1rpx solid var(--line);border-radius:24rpx;text-align:left;color:var(--text);line-height:1.4; }
.device-card-icon { display:flex;align-items:center;justify-content:center;width:96rpx;height:96rpx;border-radius:22rpx;background:var(--primary-soft);color:var(--primary);flex-shrink:0; }
.device-card-icon .monitor-icon { transform:scale(.72); }
.device-card-copy { flex:1;min-width:0; }
.device-card-name { font-size:32rpx;font-weight:650;overflow-wrap:anywhere; }
.device-card-state { display:flex;align-items:center;gap:10rpx;margin-top:12rpx;font-size:24rpx;color:var(--muted); }
.device-state-dot { width:12rpx;height:12rpx;border-radius:50%;background:currentColor;flex-shrink:0; }
.device-state-online { color:var(--primary); }
.device-state-busy { color:var(--warning); }
.device-list-note { padding:10rpx 0 24rpx;text-align:center;color:var(--muted);font-size:24rpx; }
.app-shell button.device-card { width:100%;box-sizing:border-box;margin-left:0;margin-right:0; }
