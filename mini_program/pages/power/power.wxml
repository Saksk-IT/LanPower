<view class="app-shell">
  <view wx:if="{{feedback}}" class="feedback feedback-{{feedbackKind}}" role="alert">
    <text class="feedback-copy">{{feedback}}</text>
    <button class="feedback-close" bindtap="dismissFeedback" aria-label="关闭提示">×</button>
  </view>

  <view class="page-content">
    <view class="page-heading heading-row">
      <view><view class="page-title">电脑与电源</view><view class="page-subtitle">为 Codex 开发电脑提供状态与电源管理</view></view>
      <button wx:if="{{connected}}" class="text-button" bindtap="reloadDevices" loading="{{updatingList}}" disabled="{{busy || updatingList}}">刷新</button>
    </view>

    <block wx:if="{{!connected}}">
      <view class="onboarding-card">
        <view class="onboarding-title">先连接你的开发电脑</view>
        <view class="onboarding-copy">使用 Codex 的同一份手机授权与电脑选择，按需要管理电源。</view>
        <button class="primary-button" bindtap="openSettings">前往连接与设置</button>
      </view>
      <button class="list-card list-button" bindtap="openLocal"><view class="list-content"><view class="list-title">只在家中使用？</view><view class="list-copy">通过局域网直接配对，无需 Cloud</view></view><text class="chevron">›</text></button>
    </block>

    <view wx:if="{{connected && needsReauthorize}}" class="notice-card">
      <view class="notice-title">手机授权需要更新</view><view class="notice-copy">在 Cloud 网页重新生成手机授权码。已关联电脑的局域网直连仍可尝试使用。</view>
      <button class="outline-button compact-button" bindtap="openSettings" disabled="{{busy}}">更新手机授权</button>
    </view>

    <view wx:if="{{connected && !devices.length}}" class="empty-card">
      <view class="empty-symbol"><view class="monitor-icon"><view class="monitor-screen">⏻</view><view class="monitor-stand"></view></view></view>
      <view class="onboarding-title">{{cloudState == 'unavailable' || needsReauthorize ? '暂时无法读取电脑列表' : devicesLoaded ? '还没有添加电脑' : '正在读取电脑列表'}}</view>
      <view class="onboarding-copy">{{cloudState == 'unavailable' || needsReauthorize ? '请检查手机网络和 Cloud 服务，或按提示重新授权。' : devicesLoaded ? '手机已授权。接下来在 Windows 版 CodexDock 连接同一个 Cloud，电脑就会显示在这里。' : '正在连接 Cloud，请稍候。'}}</view>
      <button class="outline-button compact-button" bindtap="reloadDevices" loading="{{updatingList}}" disabled="{{busy || updatingList}}">更新电脑列表</button>
      <button class="text-button centered-button" bindtap="openHelp">查看连接步骤</button>
    </view>

    <block wx:if="{{connected && devices.length}}">
      <picker range="{{devices}}" range-key="name" value="{{selectedIndex}}" bindchange="selectDevice" disabled="{{busy || updatingList}}" aria-label="选择要控制的电脑">
        <view class="device-picker"><view class="picker-copy"><view class="picker-title">{{device}}</view><view class="picker-sub">共 {{devices.length}} 台电脑 · 点击切换</view></view><text class="chevron">›</text></view>
      </picker>
      <view class="status-card status-{{statusClass}}">
        <view class="monitor-icon"><view class="monitor-screen">⏻</view><view class="monitor-stand"></view></view>
        <view class="status-copy"><view class="status-title">{{stateText}}</view><view class="status-detail">{{detail}}</view><view class="connection-line">{{modeText}} · {{networkText}}</view></view>
      </view>
      <view class="route-caption">{{routeHint}}</view>
      <view class="section-title-row"><view class="section-title">电源控制</view><view class="section-caption">{{controlHint}}</view></view>
      <button class="power-button wake" data-action="wake" bindtap="action" disabled="{{!canWake || busy}}"><view class="power-symbol">↟</view><view class="power-copy"><view class="power-title">开机 / 唤醒</view><view class="power-sub">{{wakeHint}}</view></view></button>
      <view class="power-grid">
        <button class="power-button" data-action="sleep" bindtap="action" disabled="{{!canControl || busy}}"><view class="power-symbol">☾</view><view class="power-copy"><view class="power-title">睡眠</view><view class="power-sub">低功耗，快速恢复</view></view></button>
        <button class="power-button" data-action="hibernate" bindtap="action" disabled="{{!canControl || busy}}"><view class="power-symbol">◐</view><view class="power-copy"><view class="power-title">休眠</view><view class="power-sub">保存状态再断电</view></view></button>
        <button class="power-button" data-action="restart" bindtap="action" disabled="{{!canControl || busy}}"><view class="power-symbol">↻</view><view class="power-copy"><view class="power-title">重启</view><view class="power-sub">重新启动 Windows</view></view></button>
        <button class="power-button danger" data-action="shutdown" bindtap="action" disabled="{{!canControl || busy}}"><view class="power-symbol">⏻</view><view class="power-copy"><view class="power-title">关机</view><view class="power-sub">请先保存文件</view></view></button>
      </view>
      <view class="action-tip">点击操作后会在手机上再次确认。指令送达后，请等待电脑状态更新。</view>
      <button class="primary-button compact-button" bindtap="openCodex" disabled="{{busy}}">返回 Codex 工作台</button>
    </block>
    <view wx:if="{{connected && devices.length}}" class="setting-card">
      <view class="setting-heading"><view class="setting-heading-copy"><view class="setting-title">电脑局域网直连</view><view class="setting-copy">手机连接与电脑同一局域网的 Wi-Fi 时，优先直接控制。</view></view><view class="setting-state {{paired ? 'success-text' : 'muted-text'}}">{{paired ? '已关联' : '可选'}}</view></view>
      <view wx:if="{{selectedId}}" class="setting-row"><text>当前电脑</text><text class="setting-value">{{device}}</text></view>
      <view wx:else class="setting-copy prerequisite">先完成手机授权，并在 Codex 首页或本页选择一台电脑。</view>
      <button class="outline-button compact-button" bindtap="scanLocal" disabled="{{busy || updatingList || !selectedId}}">{{paired ? '重新扫描电脑配对码' : '扫描电脑配对码'}}</button>
      <view wx:if="{{selectedId}}" class="setting-copy">在这台电脑的 Windows 版 CodexDock → 手机配对，点击“显示配对二维码”。</view>
      <button wx:if="{{paired}}" class="setting-row row-button" bindtap="toggleLan"><text>局域网唤醒设置</text><text class="row-end"><text wx:if="{{wakeDirty}}" class="draft-label">未保存</text><text class="chevron">{{lanOpen ? '−' : '+'}}</text></text></button>
      <view wx:if="{{paired && lanOpen}}" class="advanced-settings">
        <view class="setting-copy">用于电脑离线时发送唤醒包。配对码只包含连接信息，以下参数需要手动填写。</view>
        <label class="field-label" for="wake-mac">电脑有线网卡 MAC 地址</label>
        <input id="wake-mac" value="{{mac}}" bindinput="editMac" placeholder="例如 02-11-22-33-44-55" maxlength="17" disabled="{{busy}}" />
        <view class="field-help">在 Windows 版 CodexDock 首页的“网络与唤醒”中查看网卡 MAC。</view>
        <label class="field-label" for="wake-broadcast">局域网广播地址</label>
        <input id="wake-broadcast" value="{{broadcast}}" bindinput="editBroadcast" placeholder="例如 192.168.1.255" maxlength="15" disabled="{{busy}}" />
        <view class="field-help">可先使用默认的 255.255.255.255；指定网段地址需与家中网络一致。</view>
        <button class="outline-button compact-button" bindtap="saveWake" disabled="{{busy}}">保存唤醒设置</button>
        <view class="setting-copy">电脑还需开启网络唤醒并保持网线连接。参数仅保存在这部手机。</view>
      </view>
      <button wx:if="{{paired}}" class="danger-link remove-link" bindtap="clearLocal" disabled="{{busy}}">移除这台电脑的局域网关联</button>
    </view>
    <button class="text-button centered-button" bindtap="openHelp">需要帮助？查看使用指引</button>
  </view>

</view>
